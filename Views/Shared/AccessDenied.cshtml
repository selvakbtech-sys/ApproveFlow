@{
    ViewData["Title"] = "Access Denied";
}
<div style="max-width:460px;margin:60px auto;padding:0 16px">
  <div class="card">
    <div class="card-body" style="text-align:center;padding:32px 24px">
      <svg viewBox="0 0 24 24" style="width:44px;height:44px;stroke:var(--ng);fill:none;margin-bottom:14px" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      </svg>
      <div style="font-size:17px;font-weight:700;margin-bottom:8px">Access Denied</div>
      <div style="font-size:13px;color:var(--txt3);line-height:1.6">
        You do not have permission to perform this action.
      </div>
      @* The Common Dashboard, not the ApproveFlow one. This button is the escape hatch from a
         403, so it has to land somewhere the user can definitely open: now that permissions
         bind for every role, /Dashboard needs the "Dashboard" screen right, and a user who
         lacks it would be bounced straight back to this page. The Common Dashboard needs no
         screen permission and degrades to a "no module access" note. *@
      <a asp-controller="CommonDashboard" asp-action="Index" class="btn btn-sec" style="margin-top:18px;display:inline-flex">← Back to Dashboard</a>
    </div>
  </div>
</div>
