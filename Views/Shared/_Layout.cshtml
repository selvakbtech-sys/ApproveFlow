@using System.Security.Claims
@inject ApproveFlow.MVC.Services.INotifService NotifSvc
@{
    var uid      = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var x) ? x : 0;
    var unread   = uid > 0 ? await NotifSvc.CountUnreadAsync(uid) : 0;
    var uname    = User.FindFirstValue(ClaimTypes.Name) ?? "";
    var urole    = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var uavatar  = User.FindFirstValue("Avatar") ?? (uname.Length > 0 ? uname[..1].ToUpper() : "U");
    var ptitle   = ViewData["Title"]?.ToString() ?? "ApproveFlow";
    var navPage  = ViewData["NavPage"]?.ToString() ?? "";
    bool IsActive(string k) => navPage == k;
    // Admin sees everything; other roles see only screens where CanView claim exists
    bool CanView(string screen) =>
        urole == "Admin" ||
        User.Claims.Any(c => c.Type == "perm" && c.Value == screen);
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>@ptitle — ApproveFlow</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<div class="shell">
<aside class="sidebar" id="sidebar">
  <div class="sb-logo">
    <div class="sb-logo-icon" style="background:#fff;padding:4px;overflow:hidden">
      <img src="~/images/bnr-logo.jpg" alt="BNR" style="width:100%;height:100%;object-fit:contain"/>
    </div>
    <div><div class="sb-logo-title">BNR FLOW</div>@* <div class="sb-logo-sub">BNR Workflow Suite</div> *@</div>
  </div>
  <nav class="sb-nav">
    <div class="sb-sec">Transactions</div>
    @if (CanView("Dashboard")) {
    <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(IsActive("dashboard")?"active":"")">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22" stroke-width="1.8"/></svg>
      Dashboard
    </a>
    }
    @if (CanView("Requests")) {
    <a asp-controller="Requests" asp-action="Index" class="nav-link @(IsActive("requests")?"active":"")">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8" stroke-width="1.8"/><line x1="16" y1="13" x2="8" y2="13" stroke-width="1.8"/><line x1="16" y1="17" x2="8" y2="17" stroke-width="1.8"/></svg>
      Requests
    </a>
    }
    @if (CanView("New Request")) {
    <a asp-controller="Requests" asp-action="Create" class="nav-link @(IsActive("newrequest")?"active":"")">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke-width="2"/><line x1="5" y1="12" x2="19" y2="12" stroke-width="2"/></svg>
      New Request
    </a>
    }
    @if (CanView("Requests")) {
    <a asp-controller="Requests" asp-action="Aging" class="nav-link @(IsActive("aging")?"active":"")">
      <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10" stroke-width="2"/><line x1="12" y1="20" x2="12" y2="4" stroke-width="2"/><line x1="6" y1="20" x2="6" y2="14" stroke-width="2"/></svg>
      Aging Report
    </a>
    }

    <div class="sb-sec" style="margin-top:8px">Masters</div>
    @if (CanView("User Management")) {
    <a asp-controller="Users" asp-action="Index" class="nav-link @(IsActive("users")?"active":"")">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
      User Management
    </a>
    }
    @if (CanView("Locations")) {
    <a asp-controller="Masters" asp-action="Index" asp-route-type="locations" class="nav-link @(IsActive("locations")?"active":"")">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3" stroke-width="1.8"/></svg>
      Locations
    </a>
    }
    @if (CanView("Departments")) {
    <a asp-controller="Masters" asp-action="Index" asp-route-type="departments" class="nav-link @(IsActive("departments")?"active":"")">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="6" height="6" rx="1" stroke-width="1.8"/><rect x="15" y="3" width="6" height="6" rx="1" stroke-width="1.8"/><rect x="9" y="15" width="6" height="6" rx="1" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 9v3a3 3 0 003 3h6a3 3 0 003-3V9M12 12v3"/></svg>
      Departments
    </a>
    }
    @if (CanView("Request Types")) {
    <a asp-controller="Masters" asp-action="Index" asp-route-type="requesttypes" class="nav-link @(IsActive("reqtypes")?"active":"")">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Request Types
    </a>
    }
    @if (CanView("Workflow Definition")) {
    <a asp-controller="Workflows" asp-action="Index" class="nav-link @(IsActive("workflows")?"active":"")">
      <svg viewBox="0 0 24 24"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12" stroke-width="1.8"/></svg>
      Workflows
      <span class="nav-tag">Admin</span>
    </a>
    }
    @if (CanView("Roles & Permissions")) {
    <a asp-controller="Roles" asp-action="Index" class="nav-link @(IsActive("roles")?"active":"")">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      Roles & Permissions
      <span class="nav-tag">Admin</span>
    </a>
    }

    <div class="sb-sec" style="margin-top:8px">Account</div>
    <a asp-controller="Auth" asp-action="ChangePassword" class="nav-link @(IsActive("changepw")?"active":"")">
      <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 11V7a5 5 0 0110 0v4"/></svg>
      Change Password
    </a>
    <a asp-controller="Auth" asp-action="Logout" class="nav-link" style="color:rgba(255,255,255,.5)">
      <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
      Sign Out
    </a>
  </nav>
  <div class="sb-user">
    <div class="sb-avatar">@uavatar</div>
    <div><div class="sb-uname">@uname</div><div class="sb-urole">@urole</div></div>
  </div>
</aside>

<div id="sbOverlay" onclick="closeSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99"></div>

<div class="main">
  <header class="topbar">
    <button class="mob-menu" onclick="openSidebar()">
      <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" stroke-width="2"/><line x1="3" y1="12" x2="21" y2="12" stroke-width="2"/><line x1="3" y1="18" x2="21" y2="18" stroke-width="2"/></svg>
    </button>
    <span class="topbar-title">@ptitle</span>
    <div style="display:flex;align-items:center;gap:10px">
      <a asp-controller="Notifications" asp-action="Index" class="nb-btn" title="Notifications">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        @if (unread > 0) { <span class="nb-dot" id="nbDot">@unread</span> }
        else             { <span class="nb-dot" id="nbDot" style="display:none">0</span> }
      </a>
      <div class="user-pill">
        <div class="up-av">@uavatar</div>
        <div><div class="up-name">@uname</div><div class="up-role">@urole</div></div>
      </div>
    </div>
  </header>

  <main class="page-body">
    @if (TempData["success"] is string succ)
    {
      <div class="alert alert-ok" id="flashAlert">
        <svg viewBox="0 0 24 24"><polyline points="20,6 9,17 4,12" stroke-width="2.5"/></svg>
        @succ
        <button class="alert-close" onclick="this.closest('.alert').remove()">×</button>
      </div>
    }
    @if (TempData["error"] is string err)
    {
      <div class="alert alert-err">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><line x1="15" y1="9" x2="9" y2="15" stroke-width="2"/><line x1="9" y1="9" x2="15" y2="15" stroke-width="2"/></svg>
        @err
        <button class="alert-close" onclick="this.closest('.alert').remove()">×</button>
      </div>
    }
    @RenderBody()
  </main>
</div>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
  // Auto-dismiss success alert
  const fa = document.getElementById('flashAlert');
  if (fa) setTimeout(() => fa.remove(), 4000);
  // Mobile sidebar
  function openSidebar()  { document.getElementById('sidebar').classList.add('open');    document.getElementById('sbOverlay').style.display='block'; }
  function closeSidebar() { document.getElementById('sidebar').classList.remove('open'); document.getElementById('sbOverlay').style.display='none'; }
  // Poll notification count
  async function pollNotif() {
    try {
      const r = await fetch('/Notifications/Count');
      const d = await r.json();
      const dot = document.getElementById('nbDot');
      if (dot) { dot.textContent = d.count; dot.style.display = d.count > 0 ? '' : 'none'; }
    } catch {}
  }
  setInterval(pollNotif, 30000);
</script>
</body>
</html>
