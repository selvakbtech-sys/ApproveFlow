@model ChangePasswordVM
@{ ViewData["Title"] = "Change Password"; ViewData["NavPage"] = "changepw"; }
<div class="pg-hdr"><div><div class="pg-title">Change Password</div><div class="pg-sub">Update your account password</div></div></div>
<div style="max-width:480px">
  <div class="card">
    <div class="card-body">
      <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>
      @* Kept in the action URL and in a hidden field so the original destination survives both
         a validation error and a lost POST body (see the same pattern on the Login form). *@
      <form asp-action="ChangePassword" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl"/>
        <div class="form-group" style="margin-bottom:14px">
          <label class="lbl">Current password <span class="req">*</span></label>
          <input asp-for="CurrentPassword" type="password" class="inp"/>
          <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        </div>
        <div class="form-group" style="margin-bottom:14px">
          <label class="lbl">New password <span class="req">*</span></label>
          <input asp-for="NewPassword" type="password" class="inp"/>
          <span asp-validation-for="NewPassword" class="field-validation-error"></span>
          <div class="hint">Min 8 characters</div>
        </div>
        <div class="form-group" style="margin-bottom:22px">
          <label class="lbl">Confirm new password <span class="req">*</span></label>
          <input asp-for="ConfirmPassword" type="password" class="inp"/>
          <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
        <div style="display:flex;gap:10px">
          <button type="submit" class="btn btn-pri">Update Password</button>
          @* Matches where a successful save returns to (AuthController.GoBackOrDashboard),
             so Cancel and Update no longer land on two different dashboards. *@
          <a asp-controller="CommonDashboard" asp-action="Index" class="btn btn-sec">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
