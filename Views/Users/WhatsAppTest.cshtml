@{
    ViewData["Title"] = "WhatsApp Test";
    ViewData["NavPage"] = "users";
}

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title"><i class="bi bi-whatsapp me-2 text-success"></i>WhatsApp Test</h1>
        <p class="page-sub">Send a test WhatsApp message to verify your API configuration.</p>
    </div>
    <div class="page-header-right">
        <a href="/Users" class="btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Users
        </a>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-6">

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@ViewBag.Success</div>
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-x-circle-fill me-2 fs-5"></i>
                <div>@ViewBag.Error</div>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <i class="bi bi-send me-2"></i>Send Test Message
            </div>
            <div class="card-body p-4">
                <form method="post" action="/Users/WhatsAppTest">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-phone me-1"></i>To Number
                            <span class="text-muted small">(with country code, no + sign)</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-whatsapp text-success"></i></span>
                            <input type="text"
                                   name="toNumber"
                                   class="form-control"
                                   placeholder="919876543210"
                                   maxlength="20"
                                   required />
                        </div>
                        <div class="form-text">Enter the recipient's WhatsApp number.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-chat-text me-1"></i>Message
                        </label>
                        <textarea name="message"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Type your test message here..."
                                  required>Hello from ApproveFlow! 👋 This is a test message to verify WhatsApp integration is working correctly.</textarea>
                        <div class="form-text">Use *text* for bold, _text_ for italic.</div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-whatsapp me-2"></i>Send Test Message
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-4 border-0 bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1 text-primary"></i>Current Configuration</h6>
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted" style="width:140px">API Version</td>
                        <td><code>v19.0</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Reminder Hour</td>
                        <td><code>9:00 AM IST</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Status</td>
                        <td><span class="badge bg-success">Configured</span></td>
                    </tr>
                </table>
            </div>
        </div>

    </div>
</div>
