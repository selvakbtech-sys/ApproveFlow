@model UserListVM
@{
    ViewData["Title"] = "User Management";
    ViewData["NavPage"] = "users";
    string RCls(string r) => r switch{"Admin"=>"badge-red","Manager"=>"badge-purple","Approver L2"=>"badge-blue","Requestor"=>"badge-sky",_=>"badge-gray"};
}
<div class="pg-hdr">
  <div><div class="pg-title">User Management</div><div class="pg-sub">@Model.Items.Count users</div></div>
  <div class="pg-actions">
    <a asp-action="Create" class="btn btn-acc">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New User
    </a>
  </div>
</div>

