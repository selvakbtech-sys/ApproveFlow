@model ResetPasswordVM
@{ ViewData["Title"] = "Reset Password"; ViewData["NavPage"] = "users"; }
<div class="pg-hdr"><div><div class="pg-title">Reset Password</div><div class="pg-sub">@Model.UserName</div></div><a asp-action="Index" class="btn btn-sec">← Back</a></div>
<div style="max-width:440px">
  <div class="card">
    <div class="card-body">
      <div class="alert alert-wa" style="margin-bottom:16px">
        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke-width="2"/><line x1="12" y1="9" x2="12" y2="13" stroke-width="2"/><line x1="12" y1="17" x2="12.01" y2="17" stroke-width="2"/></svg>
        The user will be required to change their password on next login.
      </div>
      <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>
      <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId"/>
        <input type="hidden" asp-for="UserName"/>
        <div class="form-group" style="margin-bottom:14px">
          <label class="lbl">New Password <span class="req">*</span></label>
          <input asp-for="NewPassword" type="password" class="inp"/>
          <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>
        <div class="form-group" style="margin-bottom:22px">
          <label class="lbl">Confirm Password <span class="req">*</span></label>
          <input asp-for="ConfirmPassword" type="password" class="inp"/>
          <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
        <div style="display:flex;gap:10px">
          <button type="submit" class="btn btn-pri">Reset Password</button>
          <a asp-action="Index" class="btn btn-sec">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
