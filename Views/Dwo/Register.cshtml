@model DwoRegisterVM
@{
    // One grid serves three pages — Discussion Register, My Discussions and Management
    // Discussion. Mode decides the heading, the chip set, the action URL and whether the
    // HOD Set-builder column appears, so the three can never drift apart.
    bool isMine = Model.Mode == DwoGridMode.Mine;
    bool isMgmt = Model.Mode == DwoGridMode.Management;
    string action = isMine ? "MyDiscussions" : isMgmt ? "Management" : "Register";
    ViewData["Title"] = isMine ? "Discussion Point" : isMgmt ? "Management Discussion" : "Discussion Register";
    ViewData["NavPage"] = isMine ? "dwomine" : isMgmt ? "dwomanagement" : "dworegister";

    var chipStatuses = isMgmt ? DwoStatus.ManagementChips : DwoStatus.All;
    // The tick column builds a Set: an HOD from their own department's Submitted rows,
    // Management from any department's (SubmitSetAsync enforces both). Never on My Discussions.
    bool showPick = (Model.Actor.IsHod || Model.Actor.IsManagement) && !isMine;
    // Modal posts carry a returnUrl (filled in by dwo-modal.js from the live location), so
    // every action lands back here with its filters, chip and page number intact. The
    // full-page Create/Edit screens take the same URL explicitly.
    var retUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    Microsoft.AspNetCore.Routing.RouteValueDictionary ExportRoute()
    {
        var rv = Model.RouteValues();
        rv["mode"] = Model.Mode;
        return rv;
    }
}

@* Multi-select filter: a dropdown of checkboxes that all share the field name, so the GET
   form submits each ticked value as a repeated query parameter (bound to a List<>).
   Behaviour (open/close, count badge, Clear/Done) is in dwo-filters.js. *@
@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent MsFilter(
        string name, IEnumerable<(string Value, string Label)> options, IEnumerable<string> selected)
    {
        var sel = new HashSet<string>(selected);
        var sb = new System.Text.StringBuilder();
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        sb.Append($"<div class=\"msf\" data-msf>");
        sb.Append($"<button type=\"button\" class=\"f-ctrl msf-btn{(sel.Count > 0 ? " has" : "")}\" style=\"width:100%\"><span>{(sel.Count > 0 ? sel.Count + " selected" : "All")}</span><span class=\"msf-n\">{sel.Count}</span></button>");
        sb.Append("<div class=\"msf-panel\" hidden>");
        foreach (var (value, label) in options)
        {
            sb.Append($"<label><input type=\"checkbox\" name=\"{enc.Encode(name)}\" value=\"{enc.Encode(value)}\"{(sel.Contains(value) ? " checked" : "")}> {enc.Encode(label)}</label>");
        }
        sb.Append("<div class=\"msf-actions\"><button type=\"button\" class=\"btn btn-sec btn-sm\" data-msf-clear>Clear</button><button type=\"button\" class=\"btn btn-pri btn-sm\" data-msf-done>Done</button></div>");
        sb.Append("</div></div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<div class="pg-hdr">
  <div>
    <div class="pg-title">@ViewData["Title"]</div>
    <div class="pg-sub">
      @Model.TotalCount discussion@(Model.TotalCount == 1 ? "" : "s")
      @if (Model.TotalPages > 1) { <text>· Page @Model.PageNumber of @Model.TotalPages</text> }
      · @Model.Actor.RoleLabel
    </div>
  </div>
  <div class="pg-actions">
    @* Chips, Export and the pager all build their links from Model.RouteValues(), so they
       carry exactly the filters the grid was rendered with. *@
    <a href="@Url.Action("Export", ExportRoute())"
       class="btn btn-sec btn-sm" style="display:inline-flex;align-items:center;gap:6px">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9,14 12,17 15,14"/>
      </svg>
      Export Excel
    </a>
    @if (Model.Actor.CanCreate)
    {
      <a asp-action="Create" asp-route-returnUrl="@retUrl" class="btn btn-acc">
        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Discussion
      </a>
    }
  </div>
</div>

@* ── Status chips. Counts come from the same filtered query as the grid, minus the status
     filter itself, so a chip's number always matches what clicking it shows. A chip
     TOGGLES its status in the selection, so several can be lit at once; "All" clears. ── *@
<div class="dwo-chips">
  <a href="@Url.Action(action, Model.RouteValues(status: Array.Empty<string>()))"
     class="dwo-chip @(Model.FilterStatus.Count == 0 ? "active" : "")">
    All <span class="n">@Model.StatusCounts.Values.Sum()</span>
  </a>
  @foreach (var s in chipStatuses)
  {
    <a href="@Url.Action(action, Model.RouteValues(status: Model.ToggledStatus(s)))"
       class="dwo-chip @(Model.FilterStatus.Contains(s) ? "active" : "")">
      @s <span class="n">@Model.StatusCounts.GetValueOrDefault(s, 0)</span>
    </a>
  }
</div>

@if (isMgmt && Model.FilterStatus.Count == 0)
{
  <div class="alert alert-in" style="margin-bottom:10px">
    Showing every status. The pre-review ones — Draft, Submitted, Change Requested and Rejected —
    have no chip here; reach them through the Status filter.
  </div>
}

<form method="get" asp-action="@action">
  <input type="hidden" name="pageSize" value="@Model.PageSize"/>
  @* Status is chosen by the chips AND the dropdown below; the dropdown's checkboxes carry
     the field, so nothing hidden is needed for it. *@
  <div class="filter-bar" style="gap:8px">
    <div class="f-group" style="flex:1 1 160px;min-width:0">
      <label class="f-lbl">Search</label>
      <div class="f-srch-w">
        <svg class="f-srch-ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="f-ctrl f-srch" style="min-width:0;width:100%" placeholder="Title, DWO no, task…"/>
      </div>
    </div>
    <div class="f-group" style="flex:1 1 110px;min-width:0">
      <label class="f-lbl">Company</label>
      @MsFilter("FilterCompanyId", Model.Companies.Select(c => (c.CompanyId.ToString(), c.CompanyName)), Model.FilterCompanyId.Select(x => x.ToString()))
    </div>
    <div class="f-group" style="flex:1 1 100px;min-width:0">
      <label class="f-lbl">Site</label>
      @MsFilter("FilterLocationId", Model.Locations.Select(l => (l.LocationId.ToString(), l.LocationName)), Model.FilterLocationId.Select(x => x.ToString()))
    </div>
    <div class="f-group" style="flex:1 1 110px;min-width:0">
      <label class="f-lbl">Department</label>
      @MsFilter("FilterDeptId", Model.Departments.Select(d => (d.DepartmentId.ToString(), d.DeptName)), Model.FilterDeptId.Select(x => x.ToString()))
    </div>
    <div class="f-group" style="flex:1 1 110px;min-width:0">
      <label class="f-lbl">Status</label>
      @MsFilter("FilterStatus", DwoStatus.All.Select(s => (s, s)), Model.FilterStatus)
    </div>
    <div class="f-group" style="flex:1 1 100px;min-width:0">
      <label class="f-lbl">Category</label>
      <select name="FilterCategory" class="f-ctrl" style="width:100%">
        <option value="">All</option>
        @foreach (var c in Model.Categories)
        { <option value="@c" selected="@(Model.FilterCategory == c)">@c</option> }
      </select>
    </div>
    <div class="f-group" style="flex:1 1 90px;min-width:0">
      <label class="f-lbl">Priority</label>
      <select name="FilterPriority" class="f-ctrl" style="width:100%">
        <option value="">All</option>
        @foreach (var p in DwoPriority.All)
        { <option value="@p" selected="@(Model.FilterPriority == p)">@p</option> }
      </select>
    </div>
    <div class="f-group" style="flex:1 1 100px;min-width:0">
      <label class="f-lbl">Task ID</label>
      <input type="text" name="FilterTaskId" value="@Model.FilterTaskId" class="f-ctrl" style="width:100%" placeholder="Task ref"/>
    </div>
    @if (!isMine)
    {
      <div class="f-group" style="flex:1 1 120px;min-width:0">
        <label class="f-lbl">Raised By</label>
        <select name="FilterRaisedById" class="f-ctrl" style="width:100%">
          <option value="">All</option>
          @foreach (var u in Model.Raisers)
          { <option value="@u.UserId" selected="@(Model.FilterRaisedById == u.UserId)">@u.FullName</option> }
        </select>
      </div>
    }
    <div class="f-group" style="flex:0 0 130px">
      <label class="f-lbl">From</label>
      <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="f-ctrl" style="width:100%"/>
    </div>
    <div class="f-group" style="flex:0 0 130px">
      <label class="f-lbl">To</label>
      <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="f-ctrl" style="width:100%"/>
    </div>
    <div class="f-group" style="flex:0 0 auto;display:flex;align-items:flex-end;gap:6px">
      <button type="submit" class="btn btn-pri btn-sm">Filter</button>
      <a asp-action="@action" class="btn btn-sec btn-sm">Clear</a>
    </div>
  </div>
</form>

@if (showPick)
{
  @* Set builder. Only Submitted rows in the HOD's own department are tickable, which is
     also the only set of points SubmitSetAsync will accept. *@
  <div class="dwo-selbar" id="dwoSetBar">
    <div>
      <strong id="dwoSetCount">0</strong> discussion(s) selected for a Set.
      <span style="color:var(--txt2)">Tick Submitted rows, then bundle them with supporting documents and a requested management appointment.</span>
    </div>
    <button type="button" class="btn btn-acc btn-sm" id="dwoSetBtn" disabled onclick="dwoOpenBuildSet()">
      Build Set &amp; Submit to Management
    </button>
  </div>
}

<div class="card">
  <div class="tbl-wrap">
    <table class="tbl">
      <thead>
        <tr>
          @if (showPick) { <th style="width:34px"></th> }
          <th>DWO No</th>
          <th>Task ID</th>
          <th>Title</th>
          @if (!isMine) { <th>Department</th> }
          <th>Company</th>
          <th>Site</th>
          <th>Priority</th>
          <th>Status</th>
          <th>Raised On</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Items.Any())
        {
          <tr>
            <td colspan="@(showPick ? 10 : isMine ? 8 : 9)" class="tbl-empty">
              No discussions match these filters.
              @if (Model.Actor.CanCreate)
              {
                <a asp-action="Create" asp-route-returnUrl="@retUrl" style="margin-left:6px">Raise the first one →</a>
              }
            </td>
          </tr>
        }
        @foreach (var r in Model.Items)
        {
          <tr style="cursor:pointer" onclick="location.href='@Url.Action("Detail", new { id = r.PointId, returnUrl = retUrl })'">
            @if (showPick)
            {
              <td onclick="event.stopPropagation()">
                @if (r.IsSelectableForSet)
                {
                  <input type="checkbox" class="dwo-setpick" value="@r.PointId" onchange="dwoSyncSetBar()"/>
                }
              </td>
            }
            <td>
              <span class="mono" style="font-size:11px">@r.PointNumber</span>
              @if (!string.IsNullOrEmpty(r.SetNumber))
              { <div style="font-size:10px;color:var(--txt3)">@r.SetNumber</div> }
            </td>
            <td style="font-size:12px;color:var(--txt2)">@(string.IsNullOrEmpty(r.TaskId) ? "—" : r.TaskId)</td>
            <td style="font-weight:600;max-width:280px">@r.Title</td>
            @if (!isMine) { <td style="font-size:12px">@r.DeptName</td> }
            <td style="font-size:12px">@r.CompanyName</td>
            <td style="font-size:12px">@r.LocationName</td>
            <td><span class="badge @DwoPriority.Badge(r.Priority)">@r.Priority</span></td>
            <td>
              <span class="badge @DwoStatus.Badge(r.Status)">@r.Status</span>
              @if (r.IsFollowUpOverdue)
              { <span class="badge badge-red" style="margin-left:4px">Overdue</span> }
            </td>
            <td style="font-size:11px;color:var(--txt3);white-space:nowrap">@r.CreatedAt.ToString("dd MMM yyyy")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  @if (Model.TotalPages > 1)
  {
    <div class="card-footer">
      <div class="pager">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
          <a href="@Url.Action(action, Model.RouteValues(page: p))"
             class="pb @(p == Model.PageNumber ? "active" : "")">@p</a>
        }
      </div>
    </div>
  }
</div>

@section Scripts {
  <script src="~/js/dwo-filters.js" asp-append-version="true"></script>
}
