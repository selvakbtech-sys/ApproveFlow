@model MyRequestsTabVM
@{
    string Sc(string s) => s switch { "Approved"=>"badge-green","Rejected"=>"badge-red","Pending Approval"=>"badge-blue","Open"=>"badge-blue","Partial Approved"=>"badge-sky","Clarification Needed"=>"badge-purple","Draft"=>"badge-gray","Deleted"=>"badge-dark",_=>"badge-gray" };
    string ShortStatus(string s) => s switch { "Pending Approval"=>"Pending Approval","Open"=>"Pending Approval","Partial Approved"=>"Part. Approved","Clarification Needed"=>"Clarify",_=>s };
    string Pc(string p) => p switch { "Critical"=>"badge-red","High"=>"badge-amber","Medium"=>"badge-blue",_=>"badge-gray" };
}

@* ── KPI Cards ── *@
<div class="metric-row" style="grid-template-columns:repeat(7,1fr)">
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" class="metric-card" style="--mc:#0f172a">
    <div class="metric-num">@Model.MyTotal</div>
    <div class="metric-lbl">Total Request</div>
    <div class="metric-hint">All time</div>
  </a>
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" asp-route-FilterStatus="Pending Approval" class="metric-card" style="--mc:#d97706">
    <div class="metric-num">@Model.MyPending</div>
    <div class="metric-lbl">Pending Request</div>
    <div class="metric-hint">Pending Approval</div>
  </a>
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" asp-route-FilterStatus="Partial Approved" class="metric-card" style="--mc:#0369a1">
    <div class="metric-num">@Model.MyPartialApproved</div>
    <div class="metric-lbl">Partial Approved</div>
    <div class="metric-hint">&nbsp;</div>
  </a>
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" asp-route-FilterStatus="Approved" class="metric-card" style="--mc:#16a34a">
    <div class="metric-num">@Model.MyApproved</div>
    <div class="metric-lbl">Approved</div>
    <div class="metric-hint">&nbsp;</div>
  </a>
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" asp-route-FilterStatus="Rejected" class="metric-card" style="--mc:#dc2626">
    <div class="metric-num">@Model.MyRejected</div>
    <div class="metric-lbl">Rejected</div>
    <div class="metric-hint">&nbsp;</div>
  </a>
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" asp-route-FilterStatus="Draft" class="metric-card" style="--mc:#475569">
    <div class="metric-num">@Model.MyDraft</div>
    <div class="metric-lbl">Draft</div>
    <div class="metric-hint">&nbsp;</div>
  </a>
  <a asp-controller="Requests" asp-action="Index" asp-route-FilterMine="true" asp-route-FilterStatus="Clarification Needed" class="metric-card" style="--mc:#7c3aed">
    <div class="metric-num">@Model.MyClarification</div>
    <div class="metric-lbl">Clarification</div>
    <div class="metric-hint">&nbsp;</div>
  </a>
</div>

@* ── Summary Tables ── *@
<div class="dash-grid-2" style="margin-bottom:16px">
  @await Html.PartialAsync("_SummaryTable", new SummaryTableVM {
      Title = "By Request Type", LabelHeader = "Request Type",
      Icon  = "<svg viewBox='0 0 24 24' style='width:15px;height:15px' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/></svg>",
      Rows  = Model.ByTypeSummary })
  @await Html.PartialAsync("_SummaryTable", new SummaryTableVM {
      Title = "By Priority", LabelHeader = "Priority",
      Icon  = "<svg viewBox='0 0 24 24' style='width:15px;height:15px' fill='none' stroke='currentColor' stroke-width='2'><path d='M22 12h-4l-3 9L9 3l-3 9H2'/></svg>",
      Rows  = Model.ByPrioritySummary })
</div>
<div class="dash-grid-2" style="margin-bottom:16px">
  @await Html.PartialAsync("_SummaryTable", new SummaryTableVM {
      Title = "By Location", LabelHeader = "Location",
      Icon  = "<svg viewBox='0 0 24 24' style='width:15px;height:15px' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z'/><circle cx='12' cy='10' r='3'/></svg>",
      Rows  = Model.ByLocationSummary })
  @await Html.PartialAsync("_SummaryTable", new SummaryTableVM {
      Title = "By Department", LabelHeader = "Department",
      Icon  = "<svg viewBox='0 0 24 24' style='width:15px;height:15px' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z'/><polyline points='9,22 9,12 15,12 15,22'/></svg>",
      Rows  = Model.ByDepartmentSummary })
</div>

@* ── Recent Requests Grid ── *@
<div class="card" style="margin-bottom:16px">
  <div class="card-hdr">
    <svg viewBox="0 0 24 24" style="width:15px;height:15px"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
     Recent Requests
    <div class="card-hdr-right"><a asp-controller="Requests" asp-action="Index" class="btn btn-ghost btn-sm">View all →</a></div>
  </div>
  <div class="tbl-wrap">
    <table class="tbl">
      <thead>
        <tr>
          <th>Req #</th>
          <th>Request Type</th>
          <th>Created Date</th>
          <th>Status</th>
          <th>Current Approver</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var r in Model.RecentRequests)
        {
          <tr>
            <td style="font-family:monospace;font-size:11px;font-weight:600">@r.RequestNumber</td>
            <td style="font-size:12px;color:var(--txt2)">@r.RequestTypeName</td>
            <td style="font-size:11px;color:var(--txt3)">@r.CreatedAt.ToString("dd MMM yyyy")</td>
            <td><span class="badge @Sc(r.Status)">@ShortStatus(r.Status)</span></td>
            <td style="font-size:12px">
              @if (!string.IsNullOrEmpty(r.CurrentApproverName))
              {
                <span>@r.CurrentApproverName <span style="color:var(--txt3);font-size:10px">(L@(r.CurrentStepLevel))</span></span>
              }
              else if (r.Status == "Approved" || r.Status == "Rejected") { <span style="color:var(--txt3)">—</span> }
              else { <span style="color:var(--txt3)">Not assigned</span> }
            </td>
            <td><a asp-controller="Requests" asp-action="Detail" asp-route-id="@r.RequestId" class="btn btn-ghost btn-sm">Open</a></td>
          </tr>
        }
        @if (!Model.RecentRequests.Any())
        {
          <tr><td colspan="6" class="tbl-empty">No requests yet. <a asp-controller="Requests" asp-action="Create">Create one →</a></td></tr>
        }
      </tbody>
    </table>
  </div>
</div>
