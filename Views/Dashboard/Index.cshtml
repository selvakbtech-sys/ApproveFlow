@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NavPage"] = "dashboard";
    string Sc(string s) => s switch { "Approved"=>"badge-green","Rejected"=>"badge-red","Pending Approval"=>"badge-amber","Open"=>"badge-amber","Clarification Needed"=>"badge-purple","Draft"=>"badge-gray",_=>"badge-gray" };
    string Pc(string p) => p switch { "Critical"=>"badge-red","High"=>"badge-amber","Medium"=>"badge-blue",_=>"badge-gray" };
    string Sl(string s) => s switch { "Approved"=>"✅","Rejected"=>"❌","Pending Approval"=>"⏳","Open"=>"⏳","Clarification Needed"=>"💬","Draft"=>"📝",_=>"📌" };
    string ShortStatus(string s) => s switch { "Pending Approval"=>"Pending","Open"=>"Pending","Clarification Needed"=>"Clarify",_=>s };
    bool isAdmin = ViewBag.IsAdmin == true;
    bool isApprover = ViewBag.IsApprover == true;
    bool isViewOnly = ((string)(ViewBag.UserRole ?? "") == "View Only");
    var displayedRecent = isAdmin ? Model.RecentRequests : Model.MyRecentRequests;

    // ── Originating tab restore ───────────────────────────────
    // The "← Back" button on a KPI list page returns here as /Dashboard?tab=<tab>. The token
    // is resolved SERVER-SIDE so the correct panel is chosen before any script runs. Only
    // tabs this user actually has are honoured (Territory is hidden for View Only, Admin
    // Overview for non-admins); anything else falls back to the current default.
    var allowedTabs = new List<string> { "requests", "approvals" };
    if (!isViewOnly) allowedTabs.Add("territory");
    if (isAdmin) allowedTabs.Add("admin");
    var tabParam = Context.Request.Query["tab"].ToString();
    bool tabFromUrl = allowedTabs.Contains(tabParam);
    // My Approvals is the first tab and the landing tab (2026-09-19).
    string defaultTab = tabFromUrl ? tabParam : "approvals";
}

<style>
  .dash-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
  .dash-grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:16px; }
  .dash-grid-main { display:grid; grid-template-columns:3fr 2fr; gap:16px; margin-bottom:16px; }
  .metric-row { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:16px; }
  .my-metric-row { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-bottom:16px; }
  @@media(max-width:1100px) {
    .dash-grid-2 { grid-template-columns:1fr; }
    .dash-grid-3 { grid-template-columns:1fr 1fr; }
    .dash-grid-main { grid-template-columns:1fr; }
    .metric-row { grid-template-columns:repeat(3,1fr); }
    .my-metric-row { grid-template-columns:repeat(3,1fr); }
  }
  .pbar { height:6px; background:var(--bg2,#f1f5f9); border-radius:4px; overflow:hidden; }
  .pbar-fill { height:100%; background:var(--pri,#2563eb); border-radius:4px; transition:width .5s; }
  .trend-bar-wrap { flex:1; height:14px; background:var(--bg2,#f1f5f9); border-radius:4px; overflow:hidden; }
  .trend-bar-fill { height:100%; background:var(--pri,#2563eb); border-radius:4px; transition:width .5s; }
  .activity-item { display:flex; gap:10px; padding:9px 14px; border-bottom:1px solid var(--bg,#f8fafc); align-items:flex-start; }
  .activity-item:last-child { border-bottom:none; }
  .req-item { display:flex; align-items:center; gap:10px; padding:9px 14px; border-bottom:1px solid var(--bg,#f8fafc); text-decoration:none; color:inherit; transition:background .15s; }
  .req-item:hover { background:var(--bg,#f8fafc); }
  .req-item:last-child { border-bottom:none; }

  /* ── Tab bar ── */
  .dash-tab-bar { display:flex; gap:0; border-bottom:2px solid var(--bg2,#f1f5f9); margin-bottom:18px; }
  .dash-tab { padding:9px 20px; font-size:13px; font-weight:600; cursor:pointer; border:none; background:none;
              border-bottom:2px solid transparent; margin-bottom:-2px; color:var(--txt3);
              transition:color .15s, border-color .15s; display:flex; align-items:center; gap:6px; }
  .dash-tab:hover { color:var(--txt1); }
  .dash-tab.active { color:var(--pri,#2563eb); border-bottom-color:var(--pri,#2563eb); }
  .dash-tab-badge { display:inline-flex; align-items:center; justify-content:center;
                    background:#ef4444; color:#fff; border-radius:10px; padding:1px 7px;
                    font-size:10px; font-weight:700; min-width:18px; }
  .dash-tab-panel { display:none; }
  .dash-tab-panel.active { display:block; }
  .tab-loading { padding:60px; text-align:center; color:var(--txt3); font-size:13px; }
</style>

<div class="pg-hdr">
  <div>
    <div class="pg-title">Dashboard</div>
    <div class="pg-sub" style="font-size:12px;color:var(--txt3);margin-top:2px">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
  </div>
  <div class="pg-actions">
    <a asp-controller="Requests" asp-action="Create" class="btn btn-acc">
      <svg viewBox="0 0 24 24" style="width:15px;height:15px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Request
    </a>
  </div>
</div>

@* ── Alert banners ── *@
@* The "You have N requests awaiting your approval / Review now" banner was removed by
   design: the pending-approval nudge is delivered ONLY through the WhatsApp Pending
   Reminder now. The My Approvals KPI, the tab badge and the approval queue below are
   unaffected and still use Model.MyPendingApprovals. *@
@if (Model.ClarificationItems.Any())
{
  <div class="alert" style="background:var(--wa-bg);color:var(--wa);border:1px solid var(--wa-bdr);border-radius:8px;padding:10px 14px;display:flex;align-items:center;gap:8px;margin-bottom:10px;font-size:13px">
    <svg viewBox="0 0 24 24" style="width:16px;height:16px;flex-shrink:0"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    <strong>@Model.ClarificationItemsTotal</strong> request@(Model.ClarificationItemsTotal > 1 ? "s need" : " needs") clarification.
    <a href="#" onclick="switchTab('requests','myRecentRequestsCard');return false;" style="margin-left:8px;font-weight:600;color:var(--wa)">View below ↓</a>
  </div>
}

@* ── Tab Bar ── *@
<div class="dash-tab-bar">
  <button class="dash-tab" id="tab-btn-approvals" onclick="switchTab('approvals')">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/>
    </svg>
    My Approvals
    @if (Model.MyPendingApprovals > 0) { <span class="dash-tab-badge">@Model.MyPendingApprovals</span> }
  </button>
  <button class="dash-tab" id="tab-btn-requests" onclick="switchTab('requests')">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#071B46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/>
      <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10,9 9,9 8,9"/>
    </svg>
    My Requests
  </button>
  @if (!isViewOnly)
  {
    <button class="dash-tab" id="tab-btn-territory" onclick="switchTab('territory')">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      My Territory
    </button>
  }
  @if (isAdmin)
  {
    <button class="dash-tab" id="tab-btn-admin" onclick="switchTab('admin')" style="margin-left:auto">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#071B46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
      </svg>
      Admin Overview
    </button>
  }
</div>

@* ── Tab Panels ── *@

<div class="dash-tab-panel" id="tab-requests">
  <div class="tab-loading">Loading…</div>
</div>

<div class="dash-tab-panel" id="tab-approvals">
  <div class="tab-loading">Loading…</div>
</div>

@if (!isViewOnly)
{
  <div class="dash-tab-panel" id="tab-territory">
    <div class="tab-loading">Loading…</div>
  </div>
}

@* Admin Overview Tab *@
@if (isAdmin)
{
<div class="dash-tab-panel" id="tab-admin">

  @* ── TOP METRIC CARDS ── *@
  @if (isApprover)
  {
  <div class="metric-row" style="grid-template-columns:repeat(5,1fr)">
    <a asp-controller="Requests" asp-action="Approval" asp-route-dtab="admin" class="metric-card" style="--mc:#071B46">
      <div class="metric-num">@Model.AssignedToMeTotal</div>
      <div class="metric-lbl">Total Assigned to Me</div>
      <div class="metric-hint">All assigned</div>
    </a>
    <a asp-controller="Requests" asp-action="Approval" asp-route-dtab="admin" asp-route-status="Pending" class="metric-card" style="--mc:#d97706">
      <div class="metric-num">@Model.AssignedToMePending</div>
      <div class="metric-lbl">Pending Approvals</div>
      <div class="metric-hint">Awaiting my action</div>
    </a>
    <a asp-controller="Requests" asp-action="Approval" asp-route-dtab="admin" asp-route-status="Approved" class="metric-card" style="--mc:#16a34a">
      <div class="metric-num">@Model.ApprovedByMe</div>
      <div class="metric-lbl">Approved by Me</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Approval" asp-route-dtab="admin" asp-route-status="Rejected" class="metric-card" style="--mc:#dc2626">
      <div class="metric-num">@Model.RejectedByMe</div>
      <div class="metric-lbl">Rejected by Me</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Approval" asp-route-dtab="admin" asp-route-status="Clarification" class="metric-card" style="--mc:#d97706">
      <div class="metric-num">@Model.ClarificationByMe</div>
      <div class="metric-lbl">Clarification</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
  </div>
  }
  else if (isAdmin)
  {
  <div class="metric-row">
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" class="metric-card" style="--mc:#071B46">
      <div class="metric-num">@Model.Total</div>
      <div class="metric-lbl">Total Requests</div>
      <div class="metric-hint">All time</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Pending Approval" class="metric-card" style="--mc:#d97706">
      <div class="metric-num">@Model.PendingApproval</div>
      <div class="metric-lbl">Pending Approval</div>
      <div class="metric-hint">₹@Model.TotalAmountPending.ToString("N0") value</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Approved" class="metric-card" style="--mc:#16a34a">
      <div class="metric-num">@Model.Approved</div>
      <div class="metric-lbl">Approved</div>
      <div class="metric-hint">₹@Model.TotalAmountApproved.ToString("N0") value</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Rejected" class="metric-card" style="--mc:#dc2626">
      <div class="metric-num">@Model.Rejected</div>
      <div class="metric-lbl">Rejected</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Draft" class="metric-card" style="--mc:#6B7280">
      <div class="metric-num">@Model.Draft</div>
      <div class="metric-lbl">Draft</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Clarification Needed" class="metric-card" style="--mc:#d97706">
      <div class="metric-num">@Model.ClarificationNeeded</div>
      <div class="metric-lbl">Clarification</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
  </div>
  }
  else
  {
  <div class="metric-row" style="grid-template-columns:repeat(5,1fr)">
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" class="metric-card" style="--mc:#071B46">
      <div class="metric-num">@Model.MyTotal</div>
      <div class="metric-lbl">My Total Requests</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Pending Approval" class="metric-card" style="--mc:#d97706">
      <div class="metric-num">@Model.MyPending</div>
      <div class="metric-lbl">My Pending Requests</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Approved" class="metric-card" style="--mc:#16a34a">
      <div class="metric-num">@Model.MyApproved</div>
      <div class="metric-lbl">My Approved Requests</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Rejected" class="metric-card" style="--mc:#dc2626">
      <div class="metric-num">@Model.MyRejected</div>
      <div class="metric-lbl">My Rejected Requests</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
    <a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" asp-route-FilterStatus="Clarification Needed" class="metric-card" style="--mc:#d97706">
      <div class="metric-num">@Model.MyClarification</div>
      <div class="metric-lbl">My Clarification</div>
      <div class="metric-hint">&nbsp;</div>
    </a>
  </div>
  }

  @* ── ROW 1: My Pending Approvals + Activity Feed ── *@
  <div class="dash-grid-main" id="pendingApprovals">
    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
        My Pending Approvals
        @if (Model.MyPendingApprovals > 0) { <span class="badge badge-amber">@Model.MyPendingApprovals</span> }
        <div class="card-hdr-right"><a asp-controller="Requests" asp-action="Approval" asp-route-dtab="admin" asp-route-status="Pending" class="btn btn-ghost btn-sm">View all →</a></div>
      </div>
      @if (Model.MyPendingApprovalRequests.Any())
      {
        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr><th>Req #</th><th>Title</th><th>Requestor</th><th>Priority</th><th>Step</th><th>Age</th><th></th></tr>
            </thead>
            <tbody>
              @foreach (var item in Model.MyPendingApprovalRequests)
              {
                var age = (int)(DateTimeOffset.UtcNow - (item.SubmittedAt ?? item.UpdatedAt)).TotalDays;
                <tr>
                  <td style="font-family:monospace;font-size:11px;font-weight:600">@item.DisplayRequestNumber</td>
                  <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px">@item.Title</td>
                  <td style="color:var(--txt2);font-size:12px">@item.RequestorName</td>
                  <td><span class="badge @Pc(item.Priority)">@item.Priority</span></td>
                  <td style="text-align:center;font-weight:700;font-size:12px">L@(item.StepLevel)</td>
                  <td style="font-size:11px;color:@(age>5?"var(--ng)":"var(--txt3)")">@age d</td>
                  <td><a asp-controller="Requests" asp-action="Detail" asp-route-id="@item.RequestId" class="btn btn-acc btn-sm">Review →</a></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else
      {
        <div class="tbl-empty" style="padding:30px;text-align:center;color:var(--txt3)">🎉 No pending approvals</div>
      }
    </div>

    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg>
        @(isAdmin ? "Recent Activity" : "My Recent Activity")
        <div class="card-hdr-right"><a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" class="btn btn-ghost btn-sm">View all</a></div>
      </div>
      <div style="max-height:340px;overflow-y:auto">
        @foreach (var log in Model.ActivityFeed)
        {
          <div class="activity-item">
            <div style="font-size:16px;flex-shrink:0;margin-top:1px">@log.ActionIcon</div>
            <div style="flex:1;min-width:0">
              <div style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                <a asp-controller="Requests" asp-action="Detail" asp-route-id="@log.RequestId" style="color:inherit;text-decoration:none">@log.Title</a>
              </div>
              <div style="font-size:11px;color:var(--txt3)">
                <strong style="color:var(--txt2)">@log.ActorName</strong> · @log.ActionLabel
                @if (!string.IsNullOrEmpty(log.Comment)) { <span style="color:var(--txt3)"> — "@log.Comment"</span> }
              </div>
            </div>
            <div style="font-size:10px;color:var(--txt3);white-space:nowrap;flex-shrink:0;text-align:right">
              @log.CreatedAt.ToString("dd MMM")<br/>@log.CreatedAt.ToString("hh:mm tt")
            </div>
          </div>
        }
        @if (!Model.ActivityFeed.Any())
        { <div class="tbl-empty" style="padding:30px;text-align:center">No activity yet</div> }
      </div>
    </div>
  </div>

  @* ── ROW 2: My Recent Requests + Urgent Pending ── *@
  <div class="dash-grid-2">
    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
        My Recent Requests
        <div class="card-hdr-right"><a asp-controller="Requests" asp-action="Index" asp-route-dtab="admin" class="btn btn-ghost btn-sm">View all</a></div>
      </div>
      @foreach (var r in Model.MyRecentRequests)
      {
        <a asp-controller="Requests" asp-action="Detail" asp-route-id="@r.RequestId" class="req-item">
          <span style="font-size:15px">@Sl(r.Status)</span>
          <div style="flex:1;min-width:0">
            <div style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Title</div>
            <div style="font-size:11px;color:var(--txt3)">@r.RequestTypeName · @r.UpdatedAt.ToString("dd MMM, hh:mm tt")</div>
          </div>
          <span class="badge @Sc(r.Status)" style="flex-shrink:0">@ShortStatus(r.Status)</span>
        </a>
      }
      @if (!Model.MyRecentRequests.Any())
      { <div class="tbl-empty" style="padding:30px;text-align:center;color:var(--txt3)">No requests yet. <a asp-controller="Requests" asp-action="Create">Create one →</a></div> }
    </div>

    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        @(isAdmin ? "Urgent Pending" : "My Urgent Pending")
        @if (Model.UrgentPending.Any()) { <span class="badge badge-red" style="margin-left:auto">@Model.UrgentPending.Count</span> }
      </div>
      @foreach (var r in Model.UrgentPending)
      {
        <a asp-controller="Requests" asp-action="Detail" asp-route-id="@r.RequestId" class="req-item">
          <span class="badge @Pc(r.Priority)" style="flex-shrink:0">@r.Priority</span>
          <div style="flex:1;min-width:0">
            <div style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Title</div>
            <div style="font-size:11px;color:var(--txt3)">@r.RequestorName · @r.LocationName</div>
          </div>
          <span style="font-size:11px;color:var(--txt3);white-space:nowrap">@r.UpdatedAt.ToString("dd MMM")</span>
        </a>
      }
      @if (!Model.UrgentPending.Any())
      { <div class="tbl-empty" style="padding:30px;text-align:center">🎉 No urgent items!</div> }
    </div>
  </div>

  @* ── ROW 3: Clarification Needed ── *@
  @if (Model.ClarificationItems.Any())
  {
    <div class="card" style="margin-bottom:16px" id="clarification">
      <div class="card-hdr" style="color:var(--wa)">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        Needs Clarification@(isAdmin ? "" : " (Mine)")
        <span class="badge" style="background:var(--wa-bg);color:var(--wa);margin-left:auto">@Model.ClarificationItemsTotal</span>
      </div>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Req #</th><th>Title</th><th>Requestor</th><th>Type</th><th>Updated</th><th></th></tr></thead>
          <tbody>
            @foreach (var r in Model.ClarificationItems)
            {
              <tr>
                <td style="font-family:monospace;font-size:11px;font-weight:600">@r.DisplayRequestNumber</td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px">@r.Title</td>
                <td style="font-size:12px;color:var(--txt2)">@r.RequestorName</td>
                <td style="font-size:12px">@r.RequestTypeName</td>
                <td style="font-size:11px;color:var(--txt3)">@r.UpdatedAt.ToString("dd MMM, hh:mm tt")</td>
