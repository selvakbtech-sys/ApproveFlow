  <style>
    .sum-tbl { width:100%; border-collapse:collapse; font-size:12px; }
    .sum-tbl th { padding:7px 10px; text-align:left; font-weight:600; font-size:11px;
                  color:var(--txt3); border-bottom:1px solid var(--bg2,#f1f5f9); white-space:nowrap; cursor:pointer; user-select:none; }
    .sum-tbl th:hover { color:var(--txt1); }
    .sum-tbl th .sort-arrow { display:inline-block; margin-left:3px; opacity:.4; font-size:9px; }
    .sum-tbl th.sorted-asc .sort-arrow::after  { content:'▲'; opacity:1; }
    .sum-tbl th.sorted-desc .sort-arrow::after { content:'▼'; opacity:1; }
    .sum-tbl th:not(.sorted-asc):not(.sorted-desc) .sort-arrow::after { content:'⇅'; }
    .sum-tbl td { padding:7px 10px; border-bottom:1px solid var(--bg,#f8fafc); vertical-align:middle; }
    .sum-tbl tr:last-child td { border-bottom:none; }
    .sum-tbl tr:hover td { background:var(--bg,#f8fafc); }
    .sum-tbl .cat-cell { font-weight:500; color:var(--txt1); max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .sum-num-pending  { font-weight:700; color:#d97706; }
    .sum-num-approved { font-weight:700; color:#16a34a; }
    .sum-num-rejected { font-weight:700; color:#dc2626; }
    .sum-num-clarif   { font-weight:700; color:var(--wa); }
    .sum-empty        { padding:28px; text-align:center; color:var(--txt3); font-size:12px; }
  </style>

  <script>
  (function () {
    function buildTable(rows, labelHeader) {
      if (!rows || rows.length === 0)
        return '<div class="sum-empty">No data available</div>';

      var html = '<table class="sum-tbl" data-sort-col="0" data-sort-dir="asc">';
      html += '<thead><tr>';
      html += '<th class="sorted-asc" data-col="0">' + labelHeader + '<span class="sort-arrow"></span></th>';
      html += '<th data-col="1">Pending<span class="sort-arrow"></span></th>';
      html += '<th data-col="2">Approved<span class="sort-arrow"></span></th>';
      html += '<th data-col="3">Rejected<span class="sort-arrow"></span></th>';
      html += '<th data-col="4">Clarification<span class="sort-arrow"></span></th>';
      html += '</tr></thead><tbody>';

      rows.forEach(function (r) {
        html += '<tr>';
        html += '<td class="cat-cell" title="' + r.categoryName + '">' + r.categoryName + '</td>';
        html += '<td class="sum-num-pending">'  + r.pendingCount       + '</td>';
        html += '<td class="sum-num-approved">' + r.approvedCount      + '</td>';
        html += '<td class="sum-num-rejected">' + r.rejectedCount      + '</td>';
        html += '<td class="sum-num-clarif">'   + r.clarificationCount + '</td>';
        html += '</tr>';
      });
      html += '</tbody></table>';
      return html;
    }

    function attachSort(container) {
      var tbl = container.querySelector('table.sum-tbl');
      if (!tbl) return;
      tbl.querySelectorAll('th[data-col]').forEach(function (th) {
        th.addEventListener('click', function () {
          var col = parseInt(th.getAttribute('data-col'));
          var curCol = parseInt(tbl.getAttribute('data-sort-col'));
          var curDir = tbl.getAttribute('data-sort-dir');
          var newDir = (col === curCol && curDir === 'asc') ? 'desc' : 'asc';
          tbl.setAttribute('data-sort-col', col);
          tbl.setAttribute('data-sort-dir', newDir);
          tbl.querySelectorAll('th').forEach(function (h) { h.classList.remove('sorted-asc', 'sorted-desc'); });
          th.classList.add('sorted-' + newDir);

          var tbody = tbl.querySelector('tbody');
          var rows = Array.from(tbody.querySelectorAll('tr'));
          rows.sort(function (a, b) {
            var aVal = a.cells[col].textContent.trim();
            var bVal = b.cells[col].textContent.trim();
            var aNum = parseFloat(aVal);
            var bNum = parseFloat(bVal);
            var cmp = isNaN(aNum) ? aVal.localeCompare(bVal) : aNum - bNum;
            return newDir === 'asc' ? cmp : -cmp;
          });
          rows.forEach(function (r) { tbody.appendChild(r); });
        });
      });
    }

    function setBody(id, html) {
      var el = document.getElementById(id);
      if (el) { el.innerHTML = html; attachSort(el); }
    }

    function errBody(id) {
      var el = document.getElementById(id);
      if (el) el.innerHTML = '<div class="sum-empty" style="color:var(--ng)">Failed to load. <a href="#" onclick="loadSummaries();return false">Retry</a></div>';
    }

    window.loadSummaries = function () {
      fetch('/Dashboard/GetSummaries', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          setBody('summary-type-body',     buildTable(d.byType,       'Request Type'));
          setBody('summary-priority-body', buildTable(d.byPriority,   'Priority'));
          setBody('summary-location-body', buildTable(d.byLocation,   'Location'));
          setBody('summary-dept-body',     buildTable(d.byDepartment, 'Department'));
        })
        .catch(function () {
          ['summary-type-body','summary-priority-body','summary-location-body','summary-dept-body']
            .forEach(errBody);
        });
    };

  })();
  </script>
  }

</div>@* end tab-admin *@
}

@* ── Tab switching + lazy-load JS ── *@
<script>
(function () {
  const loaded = new Set(@Html.Raw(isAdmin ? "['admin']" : "[]"));
  const defaultTab = '@defaultTab';

  function activateTab(tab) {
    document.querySelectorAll('.dash-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.dash-tab-panel').forEach(p => p.classList.remove('active'));
    const btn = document.getElementById('tab-btn-' + tab);
    const panel = document.getElementById('tab-' + tab);
    if (btn) btn.classList.add('active');
    if (panel) panel.classList.add('active');
  }

  // Smoothly bring an element into view once its tab panel is on screen. Runs on the
  // next frame so it fires after the panel is displayed / its AJAX content injected.
  function scrollToTarget(scrollToId) {
    if (!scrollToId) return;
    requestAnimationFrame(function () {
      const el = document.getElementById(scrollToId);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // switchTab(tab[, scrollToId]) — activates the tab and, when a scroll target is
  // given (e.g. the clarification banner passing 'myRecentRequestsCard'), scrolls to it
  // AFTER the panel's content has loaded.
  window.switchTab = function (tab, scrollToId) {
    // Keep ?tab= in the address bar in step with the active tab, so a refresh — and the
    // browser Back button returning to this entry — land on the same tab. Also recorded in
    // sessionStorage as a fallback for history entries created before this ran.
    try {
      var u = new URL(window.location.href);
      if (u.searchParams.get('tab') !== tab) {
        u.searchParams.set('tab', tab);
        history.replaceState(null, '', u.toString());
      }
    } catch (e) { /* URL unsupported — tab still switches */ }
    try { sessionStorage.setItem('af-dash-tab', tab); } catch (e) { /* storage blocked */ }
    if (loaded.has(tab)) {
      activateTab(tab);
      scrollToTarget(scrollToId);
    } else {
      activateTab(tab);
      fetch('/Dashboard/TabData?tab=' + tab, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.text(); })
        .then(function (html) {
          const panel = document.getElementById('tab-' + tab);
          if (panel) { panel.innerHTML = html; }
          loaded.add(tab);
          scrollToTarget(scrollToId);
        })
        .catch(function () {
          const panel = document.getElementById('tab-' + tab);
          if (panel) panel.innerHTML = '<div class="tab-loading" style="color:var(--ng)">Failed to load. <a href="#" onclick="loaded.delete(\'' + tab + '\');switchTab(\'' + tab + '\');return false">Retry</a></div>';
        });
    }
    // Trigger summary tables the first time Admin Overview tab opens
    if (tab === 'admin' && typeof window.loadSummaries === 'function' && !window._summariesLoaded) {
      window._summariesLoaded = true;
      window.loadSummaries();
    }
  };

  // defaultTab is already the tab named by ?tab= when the "← Back" button sent one, so the
  // normal path needs nothing further.
  var startTab = defaultTab;

  // Fallback for the BROWSER back button only: a /Dashboard history entry created before
  // the tab was recorded carries no ?tab=, so going back to it would drop to the default tab.
  // When the navigation type is back/forward AND the URL named no tab, restore the tab last
  // opened in this session. Direct URL access and the nav menu keep the default behaviour.
  var tabCameFromUrl = @(tabFromUrl ? "true" : "false");
  if (!tabCameFromUrl) {
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var isBackForward = nav ? nav.type === 'back_forward'
                              : performance.navigation && performance.navigation.type === 2;
      var saved = sessionStorage.getItem('af-dash-tab');
      if (isBackForward && saved && document.getElementById('tab-btn-' + saved)) startTab = saved;
    } catch (e) { /* history/storage APIs unavailable — keep the default */ }
  }

  switchTab(startTab);
})();
</script>
