@model MasterFormVM
@{
    bool isEdit = Model.Id > 0;
    string typeLabel = Model.EntityType switch { "locations"=>"Location","departments"=>"Department","requesttypes"=>"Request Type","companies"=>"Company",_=>"Item" };
    ViewData["Title"] = (isEdit ? "Edit " : "New ") + typeLabel;
    string navKey = Model.EntityType switch { "locations"=>"locations","departments"=>"departments","requesttypes"=>"reqtypes","companies"=>"companies",_=>"" };
    ViewData["NavPage"] = navKey;
}
<div class="pg-hdr">
  <div><div class="pg-title">@ViewData["Title"]</div></div>
  <a asp-action="Index" asp-route-type="@Model.EntityType" class="btn btn-sec">← Back</a>
</div>
<div style="max-width:520px">
  <div class="card">
    <div class="card-body">
      <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>
      <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id"/>
        <input type="hidden" asp-for="EntityType"/>
        <div class="form-grid fg2" style="margin-bottom:14px">
          <div class="form-group">
            <label class="lbl">Code <span class="req">*</span></label>
            <input asp-for="Code" class="inp" placeholder="e.g. NYC, FIN, BGT" maxlength="20"
              oninput="this.value=this.value.toUpperCase()"/>
            <span asp-validation-for="Code" class="field-validation-error"></span>
            <div class="hint">Short identifier (max 20 chars, auto-uppercase)</div>
          </div>
          <div class="form-group">
            <label class="lbl">Name <span class="req">*</span></label>
            <input asp-for="Name" class="inp" placeholder="Full descriptive name"/>
            <span asp-validation-for="Name" class="field-validation-error"></span>
          </div>
          <div class="form-group full">
            <label class="lbl">Description</label>
            <textarea asp-for="Description" class="inp" rows="2" placeholder="Brief description (optional)"></textarea>
          </div>
        </div>
        <div class="toggle-wrap" style="margin-bottom:22px">
          <div class="toggle-box">
            <input asp-for="IsActive" type="checkbox" id="isActiveToggle"/>
            <label class="toggle-track" for="isActiveToggle">
              <span class="toggle-thumb"></span>
            </label>
          </div>
          <label class="lbl" for="isActiveToggle" style="cursor:pointer">Active (available for selection)</label>
        </div>
        <div style="display:flex;gap:10px">
          <button type="submit" class="btn btn-pri">@(isEdit ? "Save Changes" : "Create")</button>
          <a asp-action="Index" asp-route-type="@Model.EntityType" class="btn btn-sec">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
