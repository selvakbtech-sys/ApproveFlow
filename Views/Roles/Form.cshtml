@model RoleFormVM
@{
    bool isEdit = Model.RoleId > 0;
    ViewData["Title"] = isEdit ? "Edit Role" : "New Role";
    ViewData["NavPage"] = "roles";
    var colors = new[]{("badge-red","Red"),("badge-purple","Purple"),("badge-blue","Blue"),("badge-sky","Sky"),("badge-green","Green"),("badge-amber","Amber"),("badge-gray","Gray")};
    var actions = new[]{("CanCreate","Create"),("CanEdit","Edit"),("CanApprove","Approve"),("CanDelete","Delete")};
}
<div class="pg-hdr"><div><div class="pg-title">@ViewData["Title"]</div></div><a asp-action="Index" class="btn btn-sec">← Back</a></div>

<form asp-action="Save" method="post">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="RoleId"/>
  <div style="display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start">

    <div class="card">
      <div class="card-hdr"><svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>Role Settings</div>
      <div class="card-body">
        <div class="form-group" style="margin-bottom:12px">
          <label class="lbl">Role Name <span class="req">*</span></label>
          <input asp-for="RoleName" class="inp" placeholder="e.g. Finance Approver" id="roleNameInp"/>
          <span asp-validation-for="RoleName" class="field-validation-error"></span>
        </div>
        <div class="form-group" style="margin-bottom:12px">
          <label class="lbl">Description</label>
          <textarea asp-for="Description" class="inp" rows="2" placeholder="What can this role do?"></textarea>
        </div>
        <div class="form-group" style="margin-bottom:12px">
          <label class="lbl">Badge Colour</label>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
            @foreach (var (val, lbl) in colors)
            {
              <label style="display:flex;align-items:center;gap:5px;padding:5px 10px;border:2px solid var(--bdr);border-radius:20px;cursor:pointer;font-size:12px" id="clr-@val">
                <input type="radio" asp-for="BadgeColor" value="@val" onchange="pickColor()" style="display:none"/>
                <span class="badge @val" style="padding:2px 6px">@lbl</span>
              </label>
            }
          </div>
          <div style="margin-top:10px;display:flex;align-items:center;gap:8px">
            <span class="lbl">Preview:</span>
            <span class="badge @Model.BadgeColor" id="badgePreview">@(string.IsNullOrEmpty(Model.RoleName)?"Role":Model.RoleName)</span>
          </div>
        </div>
        <div class="toggle-wrap" style="margin-bottom:18px">
          <div class="toggle-box">
            <input asp-for="IsActive" type="checkbox" id="activeToggle"/>
            <label class="toggle-track" for="activeToggle"><span class="toggle-thumb"></span></label>
          </div>
          <label class="lbl" for="activeToggle" style="cursor:pointer">Active Role</label>
        </div>
        <div style="display:flex;gap:8px">
          <button type="submit" class="btn btn-pri">@(isEdit?"Save":"Create")</button>
          <a asp-action="Index" class="btn btn-sec">Cancel</a>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-hdr"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>Permission Matrix <span style="margin-left:8px;font-size:11px;color:var(--txt3)">V=View · C=Create · E=Edit · A=Approve · D=Delete</span></div>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th style="min-width:160px">Screen</th><th style="text-align:center">View</th><th style="text-align:center">Create</th><th style="text-align:center">Edit</th><th style="text-align:center">Approve</th><th style="text-align:center">Delete</th></tr></thead>
          <tbody>
            @for (int i = 0; i < Model.Permissions.Count; i++)
            {
              PermRowVM p = Model.Permissions[i];
              <tr>
                <td>
                  <input type="hidden" name="Permissions[@i].ScreenName" value="@p.ScreenName"/>
                  <div style="font-weight:600">@p.ScreenName</div>
                  @if (p.IsReport) { <div style="font-size:10px;color:var(--txt3)">Report screen</div> }
                </td>
                <td style="text-align:center">
                  <input type="checkbox" name="Permissions[@i].CanView" value="true" @(p.CanView?"checked":"")
                    style="width:16px;height:16px;accent-color:var(--ok);cursor:pointer"/>
                </td>
                @foreach (var (field, lbl) in actions)
                {
                  bool val = field=="CanCreate"?p.CanCreate:field=="CanEdit"?p.CanEdit:field=="CanApprove"?p.CanApprove:p.CanDelete;
                  <td style="text-align:center">
                    @if (p.IsReport) { <span style="color:var(--bdr)">—</span> }
                    else {
                      <input type="checkbox" name="Permissions[@i].@field" value="true" @(val?"checked":"")
                        style="width:16px;height:16px;accent-color:var(--in);cursor:pointer"/>
                    }
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script>
const nameInp = document.getElementById('roleNameInp');
const preview = document.getElementById('badgePreview');
nameInp?.addEventListener('input', () => { if(preview) preview.textContent = nameInp.value || 'Role'; });
function pickColor() {
  const sel = document.querySelector('[name="BadgeColor"]:checked')?.value;
  if (!sel || !preview) return;
  preview.className = 'badge ' + sel;
  document.querySelectorAll('[id^="clr-"]').forEach(l => {
    const v = l.querySelector('input')?.value;
    l.style.borderColor = v === sel ? 'var(--pri)' : 'var(--bdr)';
    l.style.background  = v === sel ? 'var(--bg)' : '';
  });
}
pickColor();
</script>
}
