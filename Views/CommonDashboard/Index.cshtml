@model CommonDashboardVM
@using ApproveFlow.MVC.Models.Dwo
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NavPage"] = "home";
    bool isAdmin = ViewBag.IsAdmin == true;

    string Sc(string s) => s switch {
        "Approved"=>"badge-green","Rejected"=>"badge-red","Pending Approval"=>"badge-blue","Open"=>"badge-blue",
        "Partial Approved"=>"badge-sky","Clarification Needed"=>"badge-amber","Draft"=>"badge-gray",
        "Closed"=>"badge-green","Pending"=>"badge-amber",_=>"badge-gray" };
    string Ds(string s) => s == "Open" ? "Pending Approval" : s;
}

@* ── Common Dashboard ────────────────────────────────────────────────────────────
   ApproveFlow and DWO each get their own KPI row and their own recent-records grid,
   sharing only the card design. No count, record or link crosses between them. *@

<style>
  /* Same card metrics for BOTH sections — the rows differ only in their data source. */
  .cd-kpi-row { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:18px; }
  @@media(max-width:1100px) { .cd-kpi-row { grid-template-columns:repeat(3,1fr); } }
  @@media(max-width:640px)  { .cd-kpi-row { grid-template-columns:repeat(2,1fr); } }

  .cd-sec { margin-bottom:26px; }
  .cd-sec-hdr { display:flex; align-items:center; gap:9px; margin:0 0 12px; }
  .cd-sec-bar { width:4px; height:18px; border-radius:2px; background:var(--cd,#2563eb); flex-shrink:0; }
  .cd-sec-title { font-size:15px; font-weight:700; color:var(--txt1); }
  .cd-sec-sub { font-size:11px; color:var(--txt3); }
  .cd-sec-right { margin-left:auto; }

  /* A card with no destination (DWO module not wired in) must not look clickable. */
  .metric-card.cd-static { cursor:default; }
  .metric-card.cd-static:hover { transform:none; box-shadow:none; border-color:var(--bdr); }
  .metric-card.cd-static:hover::after { transform:scaleX(0); }
  .cd-nodata { font-size:26px; font-weight:800; line-height:1; color:var(--txt3); margin-bottom:5px; }

  .cd-note { border:1px dashed var(--bdr); border-radius:var(--rl,10px); padding:14px 16px;
             font-size:12px; color:var(--txt3); background:var(--card); }
</style>

<div class="pg-hdr">
  <div>
    <div class="pg-title">Dashboard</div>
    <div class="pg-sub" style="font-size:12px;color:var(--txt3);margin-top:2px">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
  </div>
</div>

@* ══════════ SECTION 1 — ApproveFlow (ApproveFlow data only) ══════════ *@
@if (Model.ApproveFlow is { } af)
{
  <section class="cd-sec" style="--cd:#2563eb">
    <div class="cd-sec-hdr">
      <span class="cd-sec-bar"></span>
      <div>
        <div class="cd-sec-title">ApproveFlow</div>
        <div class="cd-sec-sub">@(af.IsGlobalScope ? "All approval requests" : "Your approval requests")</div>
      </div>
      <div class="cd-sec-right">
        <a asp-controller="Requests" asp-action="Index" asp-route-dtab="home" class="btn btn-ghost btn-sm">Open ApproveFlow →</a>
      </div>
    </div>

    <div class="cd-kpi-row">
      @foreach (var k in af.Kpis)
      {
        @* FilterStatus is the SAME value the count was made with, so the grid total matches. *@
        <a asp-controller="Requests" asp-action="Index"
           asp-route-FilterStatus="@k.FilterStatus" asp-route-dtab="home"
           class="metric-card" style="--mc:@k.Accent">
          <div class="metric-num">@k.Count</div>
          <div class="metric-lbl">@k.Label</div>
        </a>
      }
    </div>

    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        ApproveFlow Recent Requests
        <div class="card-hdr-right">
          <a asp-controller="Requests" asp-action="Index" asp-route-dtab="home" class="btn btn-ghost btn-sm">View all →</a>
        </div>
      </div>
      @if (af.RecentRequests.Any())
      {
        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr><th>Request No</th><th>Category</th><th>Requested By</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
              @foreach (var r in af.RecentRequests)
              {
                <tr>
                  <td style="font-family:monospace;font-size:11px;font-weight:600">
                    <a asp-controller="Requests" asp-action="Detail" asp-route-id="@r.RequestId" style="color:inherit">@r.DisplayRequestNumber</a>
                  </td>
                  <td style="font-size:12px">@r.Category</td>
                  <td style="font-size:12px;color:var(--txt2)">@r.RequestedBy</td>
                  <td><span class="badge @Sc(r.Status)">@Ds(r.Status)</span></td>
                  <td style="font-size:12px;color:var(--txt3);white-space:nowrap">@r.Date.ToString("dd MMM yyyy")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else
      {
        <div class="tbl-empty">No requests yet</div>
      }
    </div>
  </section>
}

@* ══════════ SECTION 2 — DWO (DWO data only) ══════════ *@
@if (Model.CanViewDwo)
{
  <section class="cd-sec" style="--cd:#0891b2">
    <div class="cd-sec-hdr">
      <span class="cd-sec-bar"></span>
      <div>
        <div class="cd-sec-title">DWO</div>
        <div class="cd-sec-sub">Discussion work orders</div>
      </div>
      @{ var dwoRootUrl = Model.Dwo?.DiscussionsUrl; }
      @if (!string.IsNullOrEmpty(dwoRootUrl))
      {
        <div class="cd-sec-right"><a href="@dwoRootUrl" class="btn btn-ghost btn-sm">Open DWO →</a></div>
      }
    </div>

    <div class="cd-kpi-row">
      @foreach (var (key, label, accent) in DwoKpiKeys.Ordered)
      {
        var card = Model.Dwo?.Kpis.FirstOrDefault(c => c.Key == key);
        @* A card the DWO module did not supply shows "—", never a fabricated 0. *@
        @if (card != null && !string.IsNullOrEmpty(card.Url))
        {
          <a href="@card.Url" class="metric-card" style="--mc:@accent">
            <div class="metric-num">@card.Count</div>
            <div class="metric-lbl">@(card.Label ?? label)</div>
            @if (!string.IsNullOrEmpty(card.Hint)) { <div class="metric-hint">@card.Hint</div> }
          </a>
        }
        else
        {
          <div class="metric-card cd-static" style="--mc:@accent">
            @if (card is null) { <div class="cd-nodata">—</div> }
            else               { <div class="metric-num">@card.Count</div> }
            <div class="metric-lbl">@(card?.Label ?? label)</div>
          </div>
        }
      }
    </div>

    @if (Model.Dwo is { } dwo)
    {
      <div class="card">
        <div class="card-hdr">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          DWO Recent Discussions
          @if (!string.IsNullOrEmpty(dwo.DiscussionsUrl))
          {
            <div class="card-hdr-right"><a href="@dwo.DiscussionsUrl" class="btn btn-ghost btn-sm">View all →</a></div>
          }
        </div>
        @if (dwo.RecentDiscussions.Any())
        {
          <div class="tbl-wrap">
            <table class="tbl">
              <thead>
                <tr><th>Discussion No</th><th>Project</th><th>Department</th><th>Status</th><th>Due Date</th></tr>
              </thead>
              <tbody>
                @foreach (var d in dwo.RecentDiscussions)
                {
                  <tr>
                    <td style="font-family:monospace;font-size:11px;font-weight:600">
                      @if (!string.IsNullOrEmpty(d.Url)) { <a href="@d.Url" style="color:inherit">@d.DiscussionNo</a> }
                      else { @d.DiscussionNo }
                    </td>
                    <td style="font-size:12px">@d.Project</td>
                    <td style="font-size:12px;color:var(--txt2)">@d.Department</td>
                    <td><span class="badge @Sc(d.Status)">@d.Status</span></td>
                    <td style="font-size:12px;color:var(--txt3);white-space:nowrap">@(d.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
        else
        {
          <div class="tbl-empty">No discussions yet</div>
        }
      </div>
    }
    else
    {
      @* No DWO provider in this deployment. Counts are deliberately left blank rather than
         shown as 0, which would misreport the DWO module's data. *@
      <div class="cd-note">
        The DWO module is not connected to this deployment, so its figures cannot be read.
        They appear as soon as a DWO provider is registered.
      </div>
    }
  </section>
}

@if (Model.ApproveFlow is null && !Model.CanViewDwo)
{
  <div class="cd-note">You do not have access to any module yet. Please contact your administrator.</div>
}
