@model CommonDashboardVM
@using ApproveFlow.MVC.Models.Dwo
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NavPage"] = "home";
}

@* ── Common Dashboard ────────────────────────────────────────────────────────────
   Each module gets its own KPI row and its own chart row, sharing only the card design.
   No count, series or link crosses between sections. Charts are inline SVG / CSS built
   from the same scoped figures as the KPI cards — no chart library, so the page renders
   the same on the intranet server as on dev. All styling reuses site.css classes. *@

@functions {
    // Donut: one <circle> per slice, laid end to end with stroke-dasharray around a
    // circumference of 100 (r = 15.915) so each slice's dash is simply its percentage.
    string Donut(IEnumerable<(string Label, int Count, string Color, string? Url)> slices, int total)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 42 42\" class=\"cd-donut\" role=\"img\">");
        sb.Append("<circle cx=\"21\" cy=\"21\" r=\"15.915\" fill=\"none\" stroke=\"var(--bg)\" stroke-width=\"5\"/>");
        double offset = 25; // start at 12 o'clock
        if (total > 0)
        {
            foreach (var s in slices)
            {
                if (s.Count <= 0) continue;
                double pct = s.Count * 100.0 / total;
                sb.Append($"<circle cx=\"21\" cy=\"21\" r=\"15.915\" fill=\"none\" stroke=\"{s.Color}\" stroke-width=\"5\" ");
                sb.Append($"stroke-dasharray=\"{pct:F2} {100 - pct:F2}\" stroke-dashoffset=\"{offset:F2}\"><title>{System.Net.WebUtility.HtmlEncode(s.Label)}: {s.Count}</title></circle>");
                offset -= pct;
            }
        }
        sb.Append($"<text x=\"21\" y=\"20.2\" class=\"cd-donut-num\">{total}</text>");
        sb.Append("<text x=\"21\" y=\"25.4\" class=\"cd-donut-lbl\">total</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }
}

<style>
  .cd-kpi-row { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:14px; }
  @@media(max-width:1100px) { .cd-kpi-row { grid-template-columns:repeat(3,1fr); } }
  @@media(max-width:640px)  { .cd-kpi-row { grid-template-columns:repeat(2,1fr); } }

  .cd-sec { margin-bottom:26px; }
  .cd-sec-hdr { display:flex; align-items:center; gap:9px; margin:0 0 12px; }
  .cd-sec-bar { width:4px; height:18px; border-radius:2px; background:var(--cd,#2563eb); flex-shrink:0; }
  .cd-sec-title { font-size:15px; font-weight:700; color:var(--txt1); }
  .cd-sec-sub { font-size:11px; color:var(--txt3); }
  .cd-sec-right { margin-left:auto; }

  .cd-note { border:1px dashed var(--bdr); border-radius:var(--rl,10px); padding:14px 16px;
             font-size:12px; color:var(--txt3); background:var(--card); }
  /* Stands in for a count the DWO module did not supply — never a fabricated 0. */
  .cd-nodata { font-size:26px; font-weight:800; line-height:1; color:var(--txt3); margin-bottom:5px; }

  /* Chart row: donut | trend | two distributions. Collapses to one column on phones. */
  .cd-charts { display:grid; grid-template-columns:1.1fr 1.5fr 1.2fr; gap:12px; }
  @@media(max-width:1100px) { .cd-charts { grid-template-columns:1fr 1fr; } }
  @@media(max-width:700px)  { .cd-charts { grid-template-columns:1fr; } }
  .cd-charts .card-body { padding:14px 16px; }

  /* Donut + legend */
  .cd-donut-wrap { display:flex; align-items:center; gap:14px; }
  .cd-donut { width:120px; height:120px; flex-shrink:0; transform:rotate(0); }
  .cd-donut circle { transition:stroke-width .15s; }
  .cd-donut circle:hover { stroke-width:6.5; }
  .cd-donut-num { font-size:8px; font-weight:800; text-anchor:middle; fill:var(--txt1); }
  .cd-donut-lbl { font-size:3.2px; text-anchor:middle; fill:var(--txt3); text-transform:uppercase; letter-spacing:.3px; }
  .cd-legend { display:flex; flex-direction:column; gap:5px; font-size:12px; min-width:0; flex:1; }
  .cd-legend a, .cd-legend span.row { display:flex; align-items:center; gap:7px; color:var(--txt2); text-decoration:none; }
  .cd-legend a:hover { color:var(--txt1); }
  .cd-legend i { width:9px; height:9px; border-radius:2px; flex-shrink:0; }
  .cd-legend b { margin-left:auto; color:var(--txt1); font-weight:700; }

  /* Grouped bars: two series per month, drawn to a fixed 120px plot height. */
  .cd-bars { display:flex; align-items:flex-end; gap:10px; height:140px; padding-top:14px; }
  .cd-bar-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; min-width:0; height:100%; }
  .cd-bar-pair { display:flex; align-items:flex-end; gap:3px; flex:1; width:100%; justify-content:center; }
  .cd-bar { width:38%; max-width:22px; border-radius:4px 4px 0 0; position:relative; min-height:2px; transition:opacity .15s; }
  .cd-bar:hover { opacity:.8; }
  .cd-bar em { position:absolute; top:-15px; left:50%; transform:translateX(-50%); font-size:10px; font-style:normal; color:var(--txt2); font-weight:600; }
  .cd-bar-x { font-size:10.5px; color:var(--txt3); white-space:nowrap; }
  .cd-series { display:flex; gap:14px; font-size:11px; color:var(--txt3); margin-top:6px; }
  .cd-series i { display:inline-block; width:9px; height:9px; border-radius:2px; margin-right:5px; vertical-align:-1px; }

  /* Horizontal bars */
  .cd-hbars { display:flex; flex-direction:column; gap:8px; }
  .cd-hbar { font-size:12px; }
  .cd-hbar .t { display:flex; justify-content:space-between; gap:8px; color:var(--txt2); }
  .cd-hbar .t b { color:var(--txt1); }
  .cd-hbar .t span { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .cd-split { display:grid; grid-template-columns:1fr; gap:14px; }
  .cd-sub-hdr { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:var(--txt3); margin-bottom:8px; }
  .cd-empty { font-size:12px; color:var(--txt3); padding:18px 0; text-align:center; }
</style>

<div class="pg-hdr">
  <div>
    <div class="pg-title">Dashboard</div>
    <div class="pg-sub" style="font-size:12px;color:var(--txt3);margin-top:2px">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
  </div>
</div>

@* ══════════ ApproveFlow section (ApproveFlow data only) ══════════ *@
@if (Model.ApproveFlow is { } af)
{
  var afTotal = af.Kpis.Sum(k => k.Count);
  var afSlices = af.Kpis.Select(k => (k.Label, k.Count, k.Accent, (string?)Url.Action("Index", "Requests", new { FilterStatus = k.FilterStatus })));
  var afMax = Math.Max(1, af.Trend.Select(t => Math.Max(t.Primary, t.Secondary)).DefaultIfEmpty(0).Max());
  var afTypeMax = Math.Max(1, af.ByType.Select(s => s.Count).DefaultIfEmpty(0).Max());
  var afPrioTotal = af.ByPriority.Sum(s => s.Count);

  <section class="cd-sec" style="--cd:#2563eb">
    <div class="cd-sec-hdr">
      <span class="cd-sec-bar"></span>
      <div>
        <div class="cd-sec-title">ApproveFlow</div>
        <div class="cd-sec-sub">@(af.IsGlobalScope ? "All approval requests" : "Your approval requests")</div>
      </div>
      <div class="cd-sec-right">
        <a asp-controller="Requests" asp-action="Index" class="btn btn-ghost btn-sm">Open ApproveFlow →</a>
      </div>
    </div>

    <div class="cd-kpi-row">
      @foreach (var k in af.Kpis)
      {
        @* FilterStatus is the SAME value the count was made with, so the grid total matches. *@
        <a asp-controller="Requests" asp-action="Index" asp-route-FilterStatus="@k.FilterStatus"
           class="metric-card" style="--mc:@k.Accent">
          <div class="metric-num">@k.Count</div>
          <div class="metric-lbl">@k.Label</div>
        </a>
      }
    </div>

    <div class="cd-charts">
      <div class="card">
        <div class="card-hdr">Status Overview</div>
        <div class="card-body">
          @if (afTotal == 0) { <div class="cd-empty">No requests yet</div> }
          else
          {
            <div class="cd-donut-wrap">
              @Html.Raw(Donut(afSlices, afTotal))
              <div class="cd-legend">
                @foreach (var k in af.Kpis)
                {
                  <a asp-controller="Requests" asp-action="Index" asp-route-FilterStatus="@k.FilterStatus">
                    <i style="background:@k.Accent"></i>@k.Label <b>@k.Count</b>
                  </a>
                }
              </div>
            </div>
          }
        </div>
      </div>

      <div class="card">
        <div class="card-hdr">Monthly Trend <span style="font-weight:400;color:var(--txt3);margin-left:6px">last 6 months</span></div>
        <div class="card-body">
          <div class="cd-bars">
            @foreach (var t in af.Trend)
            {
              <div class="cd-bar-col">
                <div class="cd-bar-pair">
                  <div class="cd-bar" style="height:@((t.Primary * 100.0 / afMax).ToString("F0"))%;background:#2563eb" title="Raised: @t.Primary"><em>@t.Primary</em></div>
                  <div class="cd-bar" style="height:@((t.Secondary * 100.0 / afMax).ToString("F0"))%;background:#16a34a" title="Approved: @t.Secondary"><em>@t.Secondary</em></div>
                </div>
                <div class="cd-bar-x">@t.Label</div>
              </div>
            }
          </div>
          <div class="cd-series"><span><i style="background:#2563eb"></i>Raised</span><span><i style="background:#16a34a"></i>Approved</span></div>
        </div>
      </div>

      <div class="card">
        <div class="card-hdr">Breakdown</div>
        <div class="card-body cd-split">
          <div>
            <div class="cd-sub-hdr">By request type</div>
            @if (!af.ByType.Any()) { <div class="cd-empty">No requests yet</div> }
            <div class="cd-hbars">
              @foreach (var s in af.ByType)
              {
                <div class="cd-hbar">
                  <div class="t"><span>@s.Label</span><b>@s.Count</b></div>
                  <div class="pbar"><div class="pbar-fill" style="width:@((s.Count * 100.0 / afTypeMax).ToString("F0"))%;background:@s.Color"></div></div>
                </div>
              }
            </div>
          </div>
          <div>
            <div class="cd-sub-hdr">Awaiting decision · by priority</div>
            @if (afPrioTotal == 0) { <div class="cd-empty">Nothing awaiting a decision</div> }
            else
            {
              <div class="cd-hbars">
                @foreach (var s in af.ByPriority)
                {
                  <div class="cd-hbar">
                    <div class="t"><span>@s.Label</span><b>@s.Count</b></div>
                    <div class="pbar"><div class="pbar-fill" style="width:@((s.Count * 100.0 / afPrioTotal).ToString("F0"))%;background:@s.Color"></div></div>
                  </div>
                }
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  </section>
}

@* ══════════ DWO section (DWO data only) ══════════
   Every figure and link below comes from the DWO module. Nothing here is derived from
   ApproveFlow data, and no total is combined with the row above. *@
@if (Model.CanViewDwo)
{
  var dwo = Model.Dwo;
  var dwoTotal = dwo?.ByStatus.Sum(s => s.Count) ?? 0;
  var dwoSlices = (dwo?.ByStatus ?? new()).Select(s => (s.Label, s.Count, s.Color, s.Url));
  var dwoMax = Math.Max(1, (dwo?.Trend ?? new()).Select(t => Math.Max(t.Primary, t.Secondary)).DefaultIfEmpty(0).Max());
  var dwoDeptMax = Math.Max(1, (dwo?.ByDepartment ?? new()).Select(s => s.Count).DefaultIfEmpty(0).Max());
  var dwoPrioTotal = dwo?.ByPriority.Sum(s => s.Count) ?? 0;

  <section class="cd-sec" style="--cd:#0891b2">
    <div class="cd-sec-hdr">
      <span class="cd-sec-bar"></span>
      <div>
        <div class="cd-sec-title">DWO</div>
        <div class="cd-sec-sub">Discussion work orders</div>
      </div>
      <div class="cd-sec-right">
        <a href="~/DWO/Register" class="btn btn-ghost btn-sm">Open DWO →</a>
      </div>
    </div>

    <div class="cd-kpi-row">
      @foreach (var (key, label, accent, fallbackUrl) in DwoKpiKeys.Ordered)
      {
        var card = dwo?.Kpis.FirstOrDefault(c => c.Key == key);
        @* The module may override the link; otherwise the card opens the DWO module's own
           route. The card navigates either way, so the section is useful before a provider
           is wired in. *@
        var url = string.IsNullOrEmpty(card?.Url) ? fallbackUrl : card!.Url;
        <a href="@url" class="metric-card" style="--mc:@accent">
          @* A count the module did not supply shows "—". A 0 would read as "none", which
             this application cannot state on the DWO module's behalf. *@
          @if (card is null) { <div class="cd-nodata">—</div> }
          else               { <div class="metric-num">@card.Count</div> }
          <div class="metric-lbl">@(card?.Label ?? label)</div>
        </a>
      }
    </div>

    @if (dwo is null)
    {
      @if (Model.DwoProviderRegistered)
      {
        <div class="cd-note">No DWO figures for your access level.</div>
      }
      else
      {
        @* No DWO dashboard provider in this deployment. Said plainly, so an empty section
           is never mistaken for "the DWO module has no discussions". *@
        <div class="cd-note">
          DWO figures are not available on this dashboard yet — the DWO module has not
          registered a dashboard provider. The links above open the DWO screens as usual.
        </div>
      }
    }
    else
    {
      <div class="cd-charts">
        <div class="card">
          <div class="card-hdr">Status Overview</div>
          <div class="card-body">
            @if (dwoTotal == 0) { <div class="cd-empty">No discussions yet</div> }
            else
            {
              <div class="cd-donut-wrap">
                @Html.Raw(Donut(dwoSlices, dwoTotal))
                <div class="cd-legend">
                  @foreach (var s in dwo.ByStatus)
                  {
                    <a href="@s.Url"><i style="background:@s.Color"></i>@s.Label <b>@s.Count</b></a>
                  }
                </div>
              </div>
            }
          </div>
        </div>

        <div class="card">
          <div class="card-hdr">Monthly Trend <span style="font-weight:400;color:var(--txt3);margin-left:6px">last 6 months</span></div>
          <div class="card-body">
            <div class="cd-bars">
              @foreach (var t in dwo.Trend)
              {
                <div class="cd-bar-col">
                  <div class="cd-bar-pair">
                    <div class="cd-bar" style="height:@((t.Primary * 100.0 / dwoMax).ToString("F0"))%;background:#0891b2" title="Raised: @t.Primary"><em>@t.Primary</em></div>
                    <div class="cd-bar" style="height:@((t.Secondary * 100.0 / dwoMax).ToString("F0"))%;background:#16a34a" title="Closed: @t.Secondary"><em>@t.Secondary</em></div>
                  </div>
                  <div class="cd-bar-x">@t.Label</div>
                </div>
              }
            </div>
            <div class="cd-series"><span><i style="background:#0891b2"></i>Raised</span><span><i style="background:#16a34a"></i>Closed</span></div>
          </div>
        </div>

        <div class="card">
          <div class="card-hdr">Breakdown</div>
          <div class="card-body cd-split">
            <div>
              <div class="cd-sub-hdr">By department</div>
              @if (!dwo.ByDepartment.Any()) { <div class="cd-empty">No discussions yet</div> }
              <div class="cd-hbars">
                @foreach (var s in dwo.ByDepartment)
                {
                  <div class="cd-hbar">
                    <div class="t"><span>@s.Label</span><b>@s.Count</b></div>
                    <div class="pbar"><div class="pbar-fill" style="width:@((s.Count * 100.0 / dwoDeptMax).ToString("F0"))%;background:@s.Color"></div></div>
                  </div>
                }
              </div>
            </div>
            <div>
              <div class="cd-sub-hdr">Open discussions · by priority</div>
              @if (dwoPrioTotal == 0) { <div class="cd-empty">Nothing open</div> }
              else
              {
                <div class="cd-hbars">
                  @foreach (var s in dwo.ByPriority)
                  {
                    <div class="cd-hbar">
                      <div class="t"><span>@s.Label</span><b>@s.Count</b></div>
                      <div class="pbar"><div class="pbar-fill" style="width:@((s.Count * 100.0 / dwoPrioTotal).ToString("F0"))%;background:@s.Color"></div></div>
                    </div>
                  }
                </div>
              }
            </div>
          </div>
        </div>
      </div>
    }
  </section>
}

@if (Model.ApproveFlow is null && !Model.CanViewDwo)
{
  <div class="cd-note">You do not have access to any module yet. Please contact your administrator.</div>
}
