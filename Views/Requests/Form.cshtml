@model RequestFormVM
@{
	bool isEdit = Model.RequestId > 0;
	ViewData["Title"] = isEdit ? "Edit Request" : "New Request";
	ViewData["NavPage"] = isEdit ? "requests" : "newrequest";
}
<div class="pg-hdr">
	<div>
		<div class="pg-title">@(isEdit ? "Edit Request" : "New Approval Request")</div>
		<div class="pg-sub">@(isEdit ? "Update and save" : "Fill in the form and save as draft, then submit for approval")</div>
	</div>
	<a asp-action="Index" class="btn btn-sec">← Back</a>
</div>

<form asp-action="Save" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()
	<input type="hidden" asp-for="RequestId" />
	@* LocationId and DepartmentId are posted via dropdowns in the form grid below *@

	<div style="display:grid;grid-template-columns:1fr 320px;gap:18px;align-items:start">
		<div style="display:flex;flex-direction:column;gap:14px">
			<div class="card">
				<div class="card-hdr">
					<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14,2 14,8 20,8" /></svg>
					Request Details
				</div>
				<div class="card-body">
					<div asp-validation-summary="ModelOnly" class="alert alert-err"></div>
					<div class="form-grid fg2" style="margin-bottom:14px">
						<div class="form-group full">
							<label class="lbl">Title <span class="req">*</span></label>
							<input asp-for="Title" class="inp" placeholder="Brief description of what you're requesting" />
							<span asp-validation-for="Title" class="field-validation-error"></span>
						</div>
						<div class="form-group">
							<label class="lbl">Request Type <span class="req">*</span></label>
							<select asp-for="RequestTypeId" id="rtSelect" class="inp"
									asp-items="@(new SelectList(Model.RequestTypes, "RequestTypeId", "TypeName", Model.RequestTypeId))">
								<option value="">— Select —</option>
							</select>
							<span asp-validation-for="RequestTypeId" class="field-validation-error"></span>
						</div>
						<div class="form-group">
							<label class="lbl">Amount / Value (₹)</label>
							<input asp-for="Amount" type="number" step="0.01" min="0" class="inp" placeholder="0.00" />
							<span asp-validation-for="Amount" class="field-validation-error"></span>
						</div>
						<div class="form-group">
							<label class="lbl">Department <span class="req">*</span></label>
							@if (Model.Departments.Any())
							{
								<select asp-for="DepartmentId" id="deptSelect" class="inp">
									<option value="">— Select —</option>
									@foreach (var d in Model.Departments)
									{
										if (d.DepartmentId == Model.DepartmentId)
										{
											<option value="@d.DepartmentId" selected>@d.DeptName</option>
										}
										else
										{
											<option value="@d.DepartmentId">@d.DeptName</option>
										}
									}
								</select>
							}
							else
							{
								<input type="hidden" asp-for="DepartmentId" />
								<div class="inp" style="background:var(--bg2);color:var(--txt3)">@Model.DeptName</div>
							}
							<span asp-validation-for="DepartmentId" class="field-validation-error"></span>
						</div>
						<div class="form-group">
							<label class="lbl">Location <span class="req">*</span></label>
							@if (Model.Locations.Any())
							{
								<select asp-for="LocationId" id="locSelect" class="inp">
									<option value="">— Select —</option>
									@foreach (var l in Model.Locations)
									{
										if (l.LocationId == Model.LocationId)
										{
											<option value="@l.LocationId" selected>@l.LocationName</option>
										}
										else
										{
											<option value="@l.LocationId">@l.LocationName</option>
										}
									}
								</select>
							}
							else
							{
								<input type="hidden" asp-for="LocationId" />
								<div class="inp" style="background:var(--bg2);color:var(--txt3)">@Model.LocationName</div>
							}
							<span asp-validation-for="LocationId" class="field-validation-error"></span>
						</div>
						<div class="form-group">
							<label class="lbl">Priority <span class="req">*</span></label>
							<select asp-for="Priority" id="prioSelect" class="inp">
								@foreach (var p in RequestFormVM.Priorities)
								{
									<option value="@p">@p</option>
									@*  <option value="@p" @(Model.Priority==p?"selected":"")>@p</option> *@
								}
							</select>
						</div>
						<div class="form-group">
							<label class="lbl">Description / Justification</label>
							<textarea asp-for="Description" class="inp" rows="2" placeholder="Provide context and business justification…"></textarea>
						</div>

					</div>

					<div class="form-group">
						<label class="lbl">Additional Notes</label>
						<textarea asp-for="Notes" class="inp" rows="2" placeholder="Any additional notes for approvers…"></textarea>
					</div>
				</div>
			</div>

			@* <div class="card">
				<div class="card-hdr">
					<svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
					Requestor Information
					<span style="margin-left:auto;font-size:11px;color:var(--txt3)">Auto-filled from your profile</span>
				</div>
				<div class="card-body">
					<div class="info-grid">
						<div><div class="info-lbl">Requestor</div><div class="info-val">@Model.RequestorName</div></div>
						<div><div class="info-lbl">Department</div><div class="info-val">@string.Join(", ", Model.AllDeptNames)</div></div>
						<div><div class="info-lbl">Location</div><div class="info-val">@string.Join(", ", Model.AllLocationNames)</div></div>
					</div>
				</div>
			</div> *@
		</div>

		<div style="display:flex;flex-direction:column;gap:14px">
			<div class="card">
				<div class="card-hdr">
					<svg viewBox="0 0 24 24"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12" /></svg>
					Approval Workflow
				</div>
				<div class="card-body">
					<div id="wfPreview" style="font-size:12px;color:var(--txt3);text-align:center;padding:10px">
						Select a request type to preview the approval workflow
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-hdr">
					<svg viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48" /></svg>
					Attachments
					<span style="margin-left:auto;font-size:11px;color:var(--txt3)">PDF, Word, Excel, Images — max 20 MB each</span>
				</div>
				<div class="card-body">

					@* ── Existing documents (edit mode) ── *@
					@if (Model.Documents.Any())
					{
						<div id="existingDocs" style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px">
							@foreach (var doc in Model.Documents)
							{
								<div class="existing-doc-row" id="docrow-@doc.DocumentId"
									 style="display:flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid var(--bdr);border-radius:6px;font-size:12px">
									<svg viewBox="0 0 24 24" style="width:14px;height:14px;flex-shrink:0;color:var(--pri)">
										<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
										<polyline points="14,2 14,8 20,8" />
									</svg>
									<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.FileName</span>
									<span style="color:var(--txt3);white-space:nowrap">@doc.FormattedSize</span>
									<input type="hidden" name="DeleteDocIds" class="delete-doc-flag" value="@doc.DocumentId" disabled />
									<button type="button" onclick="markDocDelete(@doc.DocumentId, this)"
											class="btn btn-ghost btn-sm" style="color:var(--ng);padding:2px 6px" title="Remove">
										<svg viewBox="0 0 24 24" style="width:13px;height:13px"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
									</button>
								</div>
							}
						</div>
					}

					@* ── New file drop zone ── *@
					<div id="dropZone"
						 style="border:2px dashed var(--bdr);border-radius:8px;padding:20px;text-align:center;cursor:pointer;transition:border-color .2s"
						 onclick="document.getElementById('fileInput').click()"
						 ondragover="event.preventDefault();this.style.borderColor='var(--pri)'"
						 ondragleave="this.style.borderColor='var(--bdr)'"
						 ondrop="handleDrop(event)">
						<svg viewBox="0 0 24 24" style="width:28px;height:28px;color:var(--txt3);margin-bottom:6px">
							<polyline points="16,16 12,12 8,16" />
							<line x1="12" y1="12" x2="12" y2="21" />
							<path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3" />
						</svg>
						<div style="font-size:13px;font-weight:600;color:var(--txt2)">Drop files here or click to browse</div>
						<div style="font-size:11px;color:var(--txt3);margin-top:3px">Multiple files supported</div>
						<input type="file" id="fileInput" name="NewFiles" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.zip"
							   style="display:none" onchange="handleFiles(this.files)" />
					</div>

					@* ── Queued new files list ── *@
					<div id="newFileList" style="margin-top:10px;display:flex;flex-direction:column;gap:5px"></div>
				</div>
			</div>

			<div class="card">
				<div class="card-body" style="display:flex;flex-direction:column;gap:8px">
					<button type="submit" name="saveAction" value="draft" class="btn btn-sec" style="justify-content:center">
						<svg viewBox="0 0 24 24" style="width:15px;height:15px">
							<path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
							<polyline points="17,21 17,13 7,13 7,21" />
						</svg>
						Save as Draft
					</button>
					<button type="submit" name="saveAction" value="submit" class="btn btn-pri" style="justify-content:center">
						<svg viewBox="0 0 24 24" style="width:15px;height:15px">
							<line x1="22" y1="2" x2="11" y2="13" />
							<polygon points="22,2 15,22 11,13 2,9" />
						</svg>
						Save &amp; Submit for Approval
					</button>
					<a asp-action="Index" class="btn btn-ghost" style="justify-content:center">Cancel</a>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	<script>
		const rtSel   = document.getElementById('rtSelect');
		const prioSel = document.getElementById('prioSelect');
		const prev    = document.getElementById('wfPreview');
		async function loadWf() {
		  const tid = rtSel?.value; const pri = prioSel?.value || 'Medium';
		  if (!tid) return;
		  try {
			const r = await fetch(`/Requests/WfPreview?requestTypeId=${tid}&priority=${pri}`);
			const d = await r.json();
			if (!d.matched) { prev.innerHTML='<div class="alert alert-wa" style="font-size:12px;margin:0">No workflow matched for this combination. Contact Admin.</div>'; return; }
			const nodes = d.steps.map((s,i) => `<div class="wf-node"><div class="wf-num">${s.stepLevel}</div><div><div style="font-size:12px;font-weight:600">${s.name}</div><div style="font-size:10px;color:var(--txt3)">Level ${s.stepLevel}</div></div></div>${i<d.steps.length-1?'<span class="wf-arrow">→</span>':''}`).join('');
			prev.innerHTML = `<div class="alert alert-in" style="font-size:12px;margin-bottom:10px">Auto-matched: <strong>${d.workflowName}</strong></div><div class="wf-preview">${nodes}</div>`;
		  } catch { prev.innerHTML='<div style="color:var(--txt3);font-size:12px">Could not load preview</div>'; }
		}
		rtSel?.addEventListener('change', loadWf);
		prioSel?.addEventListener('change', loadWf);
		document.getElementById('locSelect')?.addEventListener('change', loadWf);
		document.getElementById('deptSelect')?.addEventListener('change', loadWf);
		if (rtSel?.value) loadWf();
		// ── Document handling ────────────────────────────────────────
		let selectedFiles = new DataTransfer();

		function handleFiles(files) {
		  for (const f of files) selectedFiles.items.add(f);
		  renderFileList();
		}

		function handleDrop(e) {
		  e.preventDefault();
		  document.getElementById('dropZone').style.borderColor = 'var(--bdr)';
		  handleFiles(e.dataTransfer.files);
		}

		function renderFileList() {
		  const input = document.getElementById('fileInput');
		  input.files = selectedFiles.files;
		  const list  = document.getElementById('newFileList');
		  list.innerHTML = '';
		  Array.from(selectedFiles.files).forEach((f, i) => {
			const size = f.size > 1048576 ? (f.size/1048576).toFixed(1)+' MB' : Math.round(f.size/1024)+' KB';
			const row  = document.createElement('div');
			row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--bg2);border-radius:6px;font-size:12px';
			row.innerHTML = `
			  <svg viewBox="0 0 24 24" style="width:13px;height:13px;color:var(--pri);flex-shrink:0">
				<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
				<polyline points="14,2 14,8 20,8"/>
			  </svg>
			  <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${f.name}</span>
			  <span style="color:var(--txt3);white-space:nowrap">${size}</span>
			  <button type="button" onclick="removeQueuedFile(${i})"
				style="background:none;border:none;cursor:pointer;color:var(--ng);padding:0 4px;font-size:15px" title="Remove">×</button>`;
			list.appendChild(row);
		  });
		}

		function removeQueuedFile(index) {
		  const dt = new DataTransfer();
		  Array.from(selectedFiles.files).forEach((f, i) => { if (i !== index) dt.items.add(f); });
		  selectedFiles = dt;
		  renderFileList();
		}

		function markDocDelete(docId, btn) {
		  const row   = document.getElementById('docrow-' + docId);
		  const flag  = row.querySelector('.delete-doc-flag');
		  const isDel = flag.disabled;
		  flag.disabled = !isDel;
		  row.style.opacity   = isDel ? '1' : '0.4';
		  row.style.textDecoration = isDel ? 'none' : 'line-through';
		  btn.title = isDel ? 'Remove' : 'Undo remove';
		}
	</script>
}
