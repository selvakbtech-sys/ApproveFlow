@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Link Expired — ApproveFlow</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<div style="max-width:420px;margin:80px auto;padding:0 16px">
  <div class="card">
    <div class="card-body" style="text-align:center;padding:32px 24px">
      <svg viewBox="0 0 24 24" style="width:40px;height:40px;stroke:var(--ng);fill:none;margin-bottom:14px" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div style="font-size:16px;font-weight:700;margin-bottom:8px">Invalid or Expired Link</div>
      <div style="font-size:13px;color:var(--txt3);line-height:1.6">This link is invalid or has expired. Please contact the requestor or your administrator for a new link.</div>
    </div>
  </div>
</div>
</body>
</html>
