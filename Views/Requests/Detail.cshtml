@model RequestFormVM
@{
    ViewData["Title"] = "Request Details";
    ViewData["NavPage"] = "requests";
    string Sc(string s) => s switch{"Approved"=>"badge-green","Rejected"=>"badge-red","Pending Approval"=>"badge-blue","Open"=>"badge-blue","Partial Approved"=>"badge-sky","Clarification Needed"=>"badge-amber","Draft"=>"badge-gray","Deleted"=>"badge-dark","Revoked"=>"badge-gray",_=>"badge-gray"};
    string Pc(string p) => p switch{"Critical"=>"badge-red","High"=>"badge-amber","Medium"=>"badge-blue",_=>"badge-gray"};
    string Ds(string s) => s == "Open" ? "Pending Approval" : s;
    string SCls(string s) => s switch{"approved"=>"sn-ok","rejected"=>"sn-ng","pending"=>"sn-wa","clarification"=>"sn-cl",_=>"sn-wait"};
    string TlCls(string a) => a switch{"approved"=>"tl-approved","rejected"=>"tl-rejected","clarification"=>"tl-clarification","clarification_response"=>"tl-submitted","submitted"=>"tl-submitted","revoked"=>"tl-rejected",_=>"tl-saved_draft"};
    string TlIco(string a) => a switch{"approved"=>"✓","rejected"=>"✕","clarification"=>"?","clarification_response"=>"↩","submitted"=>"↑","revoked"=>"⟲",_=>"·"};
    string TlLbl(string a) => a switch{"approved"=>"approved the request","rejected"=>"rejected the request","clarification"=>"requested clarification","clarification_response"=>"responded to clarification","submitted"=>"submitted for approval","saved_draft"=>"saved as draft","deleted"=>"deleted the request","revoked"=>"revoked the request",_=>a};
    var tab = Model.ActiveTab ?? "details";
    // "mobile" when this page was opened from the mobile Pending Approvals page, otherwise
    // null. Every link and form below carries it through (asp-route-source renders nothing
    // when null), so Back and the post-action redirects return to where the user came from.
    var src = ViewBag.Source as string;
    // ?ret= is the list/dashboard URL this page was opened from (set by the grid links). It
    // is honoured only when it is a local URL, so Back returns to the exact screen — the
    // Territory/Approvals grid with its KPI filter, search and page — instead of the default
    // request list. Missing or non-local → the original destination, unchanged.
    var retUrl = Context.Request.Query["ret"].ToString();
    var backUrl = src == "mobile" ? "/Mobile/PendingApprovals"
                : Url.IsLocalUrl(retUrl) ? retUrl
                : Url.Action("Index");
    // True only for a territory-only viewer (not the owner, an approver, or admin). The page
    // renders read-only for them: every mutating control and attachment download below is
    // hidden. False for all existing users, so their view is unchanged.
    bool readOnly = ViewBag.ReadOnly == true;
}

<div class="pg-hdr">
  <div>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <div class="pg-title">@Model.DisplayRequestNumber</div>
      <span class="badge @Sc(Model.Status)">@Ds(Model.Status)</span>
      <span class="badge @Pc(Model.Priority)">@Model.Priority</span>
    </div>
    <div class="pg-sub" style="font-size:20px;font-weight:700;color:var(--txt1)">@Model.Title</div>
  </div>
  <div class="pg-actions">
    <a href="@backUrl" class="btn btn-sec btn-sm">← Back</a>
    @if (!readOnly && Model.Status == "Draft")
    {
      <a asp-action="Edit" asp-route-id="@Model.RequestId" class="btn btn-sec btn-sm">Edit</a>
      <form asp-action="Submit" asp-route-id="@Model.RequestId" asp-route-source="@src" method="post" style="display:inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-acc btn-sm"
          onclick="return confirm('Submit for approval?')">
          <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9 22,2"/></svg>
          Submit
        </button>
      </form>
    }
    @if (!readOnly && ViewBag.CanDelete == true)
    {
      @if (Model.Status == "Pending Approval" || Model.Status == "Open")
      {
        <form asp-action="Delete" asp-route-id="@Model.RequestId" asp-route-source="@src" method="post" style="display:inline">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn-ng btn-sm"
            onclick="return confirm('Delete request @Model.DisplayRequestNumber? This cannot be undone.')">
            Delete
          </button>
        </form>
      }
      else
      {
        <button type="button" class="btn btn-ng btn-sm"
          onclick="alert('Only requests with Pending Approval status can be deleted.')">
          Delete
        </button>
      }
    }
    @if (Model.CanRevoke)
    {
      <button type="button" class="btn btn-sm" title="Revoke Request"
        onclick="openRevokeModal(@Model.RequestId, '@Model.DisplayRequestNumber')"
        style="border:1px solid var(--txt3,#6b7280);background:transparent;color:var(--txt2);display:inline-flex;align-items:center;gap:5px">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        Revoke
      </button>
    }
  </div>
</div>

<div class="tabs">
  <a asp-action="Detail" asp-route-id="@Model.RequestId" asp-route-tab="details"   asp-route-source="@src" class="tab @(tab=="details"?"active":"")">Details</a>
  <a asp-action="Detail" asp-route-id="@Model.RequestId" asp-route-tab="approval"  asp-route-source="@src" class="tab @(tab=="approval"?"active":"")">Approval Chain <span class="tab-cnt">@Model.ApprovalChain.Count</span></a>
  <a asp-action="Detail" asp-route-id="@Model.RequestId" asp-route-tab="history"   asp-route-source="@src" class="tab @(tab=="history"?"active":"")">History <span class="tab-cnt">@Model.ActionLog.Count</span></a>
  <a asp-action="Detail" asp-route-id="@Model.RequestId" asp-route-tab="documents" asp-route-source="@src" class="tab @(tab=="documents"?"active":"")">Documents <span class="tab-cnt">@Model.TotalDocumentCount</span></a>
</div>

@if (tab == "details")
{
  @if (Model.IsRevoked)
  {
    <div class="card" style="border:1px solid var(--bdr);border-left:4px solid #6b7280;margin-bottom:16px">
      <div style="padding:14px 18px">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--txt3);margin-bottom:12px">Revoke Information</div>
        <div class="m-collapse-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px">
          <div><div class="info-lbl">Revoked By</div><div class="info-val">@Model.RevokedByName</div></div>
          <div><div class="info-lbl">Revoked Date</div><div class="info-val">@(Model.RevokedDate?.ToString("dd MMM yyyy hh:mm tt"))</div></div>
          <div style="grid-column:1 / -1"><div class="info-lbl">Reason</div><div class="info-val" style="white-space:pre-wrap;line-height:1.6">@Model.RevokedRemark</div></div>
        </div>
      </div>
    </div>
  }
  <div class="m-collapse" style="display:grid;grid-template-columns:1fr 320px;gap:16px;align-items:start">
    <div class="card">
      <div style="padding:16px 18px;border-bottom:1px solid var(--bdr)">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--txt3);margin-bottom:14px">Request Information</div>
        <div class="m-collapse-2" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:16px">
          <div><div class="info-lbl">Amount</div><div class="info-val" style="font-size:15px;font-weight:700">@(Model.Amount.HasValue?"₹"+Model.Amount.Value.ToString("N2"):"—")</div></div>
          <div><div class="info-lbl">Request Type</div><div class="info-val">@Model.RequestTypeName</div></div>
          <div><div class="info-lbl">Department</div><div class="info-val">@Model.DeptName</div></div>
          <div><div class="info-lbl">Location</div><div class="info-val">@Model.LocationName</div></div>
        </div>
        <div class="m-collapse-2" style="border-top:1px solid var(--bg2);padding-top:14px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px">
          <div><div class="info-lbl">Requestor</div><div class="info-val">@Model.RequestorName</div></div>
          <div><div class="info-lbl">Requested On</div><div class="info-val">@Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</div></div>
        </div>
      </div>
      @if (!string.IsNullOrEmpty(Model.Description))
      {
        <div style="padding:14px 18px;border-bottom:1px solid var(--bdr)">
          <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--txt3);margin-bottom:8px">Description</div>
          <div style="font-size:13px;color:var(--txt2);line-height:1.7;background:var(--bg);border:1px solid var(--bdr);border-radius:var(--r);padding:10px 13px">@Model.Description</div>
        </div>
      }
      @* Additional Notes — always shown on the view screen (muted "—" when none was entered). *@
      <div style="padding:14px 18px">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--txt3);margin-bottom:8px">Additional Notes</div>
        <div style="font-size:13px;line-height:1.7;background:var(--bg);border:1px solid var(--bdr);border-radius:var(--r);padding:10px 13px;color:@(string.IsNullOrEmpty(Model.Notes) ? "var(--txt3)" : "var(--txt2)")">@(string.IsNullOrEmpty(Model.Notes) ? "—" : Model.Notes)</div>
      </div>
    </div>

    <div>
      @if (Model.CanSubmitClarification)
      {
        <div class="card" id="clarificationPanel" style="border:2px solid var(--wa);margin-bottom:14px">
          <div class="card-hdr" style="background:var(--wa-bg);border-bottom-color:var(--wa-bdr)">
            <svg viewBox="0 0 24 24" style="stroke:var(--wa)"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke-width="2"/></svg>
            <span style="color:var(--wa)">Clarification Requested</span>
          </div>
          <div class="card-body">
            <style>
              textarea.readonly-remark {
                resize:none; overflow:hidden; min-height:70px; max-height:250px; width:100%;
                font-family:inherit; font-size:13px; line-height:1.6; color:var(--txt2);
                background:var(--wa-bg); border:1px solid var(--wa-bdr); border-radius:var(--r); padding:10px 13px;
              }
            </style>
            @if (!string.IsNullOrEmpty(Model.LatestClarificationComment))
            {
              <div class="form-group" style="margin-bottom:14px">
                <textarea id="prevClarRemark" class="readonly-remark" readonly>@Model.LatestClarificationComment</textarea>
              </div>
            }
            <form id="clarificationForm" asp-action="SubmitClarification" asp-route-id="@Model.RequestId" asp-route-source="@src" method="post" enctype="multipart/form-data">
              @Html.AntiForgeryToken()
              <div class="form-group" style="margin-bottom:12px">
                <label class="lbl">Clarification Remarks <span style="color:var(--ng)">*</span></label>
                <textarea id="clarificationRemarks" name="clarificationRemarks" class="inp" rows="3" maxlength="500" placeholder="Type your clarification response for the approver…" style="resize:none;overflow:hidden;min-height:70px;max-height:250px"></textarea>
                <div style="text-align:right;font-size:11px;color:var(--txt3);margin-top:4px"><span id="clarRemarksCount">0</span> / 500</div>
              </div>
              <div class="form-group" style="margin-bottom:12px">
                <label class="lbl">Attachment <span style="font-weight:400;color:var(--txt3)">(Optional)</span></label>
                <input type="file" name="clarificationFile" class="inp" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                <div class="hint">PDF, Word, Excel, JPG/PNG — max 20 MB</div>
              </div>
              <button type="submit" class="btn btn-acc" style="justify-content:center;width:100%"
                onclick="return clarRequireRemarks(this)">
                <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9 22,2"/></svg>
                Submit Clarification
              </button>
            </form>
            <script>
              (function () {
                // Grow a textarea to fit its content (70–250px; scroll only if content
                // would exceed the max height).
                function autoGrow(ta) {
                  if (!ta) return;
                  ta.style.height = 'auto';
                  if (ta.scrollHeight > 250) { ta.style.height = '250px'; ta.style.overflowY = 'auto'; }
                  else { ta.style.height = ta.scrollHeight + 'px'; ta.style.overflowY = 'hidden'; }
                }
                // Read-only previous-remark: size once on load.
                autoGrow(document.getElementById('prevClarRemark'));
                // Editable Clarification Remarks: auto-grow while typing + live counter.
                var remarks = document.getElementById('clarificationRemarks');
                var counter = document.getElementById('clarRemarksCount');
                if (remarks) {
                  var upd = function () {
                    if (counter) counter.textContent = remarks.value.length;
                    autoGrow(remarks);
                  };
                  remarks.addEventListener('input', upd);
                  upd();
                }
              })();

              function clarRequireRemarks(btn) {
                var ta = btn.closest('form').querySelector('textarea[name="clarificationRemarks"]');
                if (!ta || ta.value.trim() === '') {
                  alert('Clarification Remarks are required.');
                  if (ta) ta.focus();
                  return false;
                }
                if (ta.value.length > 500) {
                  alert('Clarification Remarks cannot exceed 500 characters.');
                  ta.focus();
                  return false;
                }
                return true;
              }
            </script>
          </div>
        </div>
      }

      @if (Model.CanAct)
      {
        <div class="card" style="border:2px solid var(--wa);margin-bottom:14px">
          <div class="card-hdr" style="background:var(--wa-bg);border-bottom-color:var(--wa-bdr)">
            <svg viewBox="0 0 24 24" style="stroke:var(--wa)"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke-width="2"/><line x1="12" y1="9" x2="12" y2="13" stroke-width="2"/><line x1="12" y1="17" x2="12.01" y2="17" stroke-width="2"/></svg>
            <span style="color:var(--wa)">
              Your Action Required — Level @Model.CurrentActingStep
              @{ var actingStepInfo = Model.ApprovalChain.FirstOrDefault(s => s.StepLevel == Model.CurrentActingStep); }
              @if (actingStepInfo != null)
              { <span style="font-weight:400;font-size:12px"> · @actingStepInfo.ApproverRole</span> }
            </span>
          </div>
          <div class="card-body">
            <form id="approvalActionForm" asp-action="Action" asp-route-id="@Model.RequestId" asp-route-source="@src" method="post" enctype="multipart/form-data">
              @Html.AntiForgeryToken()
              <div class="form-group" style="margin-bottom:12px">
                <label class="lbl">Comment</label>
                <textarea name="comment" class="inp" rows="3" placeholder="Required for rejection/clarification…"></textarea>
              </div>
              <div class="form-group" style="margin-bottom:12px">
                <label class="lbl">Attachment <span style="font-weight:400;color:var(--txt3)">(Optional)</span></label>
                <input type="file" name="approvalFile" class="inp" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                <div class="hint">PDF, Word, Excel, JPG/PNG — max 20 MB</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:8px">
                <button type="submit" name="action" value="approved" class="btn btn-ok" style="justify-content:center">
                  <svg viewBox="0 0 24 24"><polyline points="20,6 9,17 4,12" stroke-width="2.5"/></svg>Approve
                </button>
                <button type="submit" name="action" value="clarification" class="btn btn-wa" style="justify-content:center"
                  onclick="return wfRequireComment(this,'Clarification remarks are required.')">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Request Clarification
                </button>
                <button type="submit" name="action" value="rejected" class="btn btn-ng" style="justify-content:center"
                  onclick="return wfRequireComment(this,'Rejection remarks are required.') &amp;&amp; confirm('Reject this request?')">
                  <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" stroke-width="2.5"/><line x1="6" y1="6" x2="18" y2="18" stroke-width="2.5"/></svg>Reject
                </button>
              </div>
            </form>
            @* Approve = comment optional; Reject & Clarification = comment mandatory (same rules as WhatsApp). *@
            <script>
              function wfRequireComment(btn, msg) {
                var ta = btn.closest('form').querySelector('textarea[name="comment"]');
                if (!ta || ta.value.trim() === '') {
                  alert(msg);
                  if (ta) ta.focus();
                  return false;
                }
                return true;
              }
              // Enforce a single action per request on the client: once any button is
              // pressed (and its inline validation passed), disable ALL action buttons,
              // show a loading indicator, and block any repeat submit / double-click.
              // The server still validates independently — this is only UX.
              (function () {
                var form = document.getElementById('approvalActionForm');
                if (!form) return;
                form.addEventListener('submit', function (e) {
                  if (form.dataset.submitting === '1') { e.preventDefault(); return; }
                  // Disabled buttons are not posted, so carry the chosen action in a
                  // hidden field before disabling the button that was clicked.
                  var submitter = e.submitter || document.activeElement;
                  var action = (submitter && submitter.name === 'action') ? submitter.value : null;
                  if (action) {
                    var hid = document.createElement('input');
                    hid.type = 'hidden'; hid.name = 'action'; hid.value = action;
                    form.appendChild(hid);
                  }
                  form.dataset.submitting = '1';
                  form.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
                  if (submitter && submitter.tagName === 'BUTTON') {
                    submitter.innerHTML = '<span class="spin"></span> Processing…';
                  }
                });
              })();
            </script>
          </div>
        </div>
      }

      <div class="card">
        <div class="card-hdr">
          <svg viewBox="0 0 24 24"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg>
          Approval Progress
        </div>
        <div class="card-body">
          @if (!Model.ApprovalChain.Any())
          { <div style="font-size:12px;color:var(--txt3);text-align:center">Not yet submitted</div> }
          <div class="chain">
            @foreach (var step in Model.ApprovalChain)
            {
              <div class="chain-step @(step.Status=="waiting"?"waiting":"")">
                <div class="snum @SCls(step.Status)">@step.StepLevel</div>
                <div style="flex:1;min-width:0">
                  <div class="step-name">@step.ApproverRole</div>
                  <div style="font-size:10px;color:var(--txt3);margin-bottom:3px">Level @step.StepLevel</div>
                  @if (!string.IsNullOrEmpty(step.Comment))
                  { <div class="step-cmt">"@step.Comment"</div> }
                </div>
                <span class="badge @(step.Status switch{"approved"=>"badge-green","rejected"=>"badge-red","pending"=>"badge-amber","clarification"=>"badge-amber",_=>"badge-gray"})">
                  @(step.Status switch{"approved"=>"Approved","rejected"=>"Rejected","pending"=>"Pending","clarification"=>"Clarify",_=>"Waiting"})
                </span>
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  </div>
}

@if (tab == "approval")
{
  <div style="max-width:640px">
    <div class="card">
      <div class="card-body">
        @if (!Model.ApprovalChain.Any())
        { <div class="tbl-empty">Approval chain appears after submission.</div> }
        <div class="chain">
          @foreach (var step in Model.ApprovalChain)
          {
            <div class="chain-step @(step.Status=="waiting"?"waiting":"")">
              <div class="snum @SCls(step.Status)">@step.StepLevel</div>
              <div style="flex:1;min-width:0">
                <div class="step-name">@step.ApproverRole</div>
                <div style="font-size:10px;color:var(--txt3);margin-bottom:2px">Level @step.StepLevel</div>
                @if (step.ActionAt.HasValue)
                { <div style="font-size:11px;color:var(--txt3)">@step.ActionAt.Value.ToString("dd MMM yyyy, hh:mm tt") IST</div> }
                @if (!string.IsNullOrEmpty(step.Comment))
                { <div class="step-cmt">"@step.Comment"</div> }
              </div>
              <span class="badge @(step.Status switch{"approved"=>"badge-green","rejected"=>"badge-red","pending"=>"badge-amber","clarification"=>"badge-amber",_=>"badge-gray"})">
                @(step.Status switch{"approved"=>"Approved","rejected"=>"Rejected","pending"=>"Pending","clarification"=>"Clarify",_=>"Waiting"})
              </span>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
}

@if (tab == "history")
{
  <div style="max-width:640px">
    <div class="card">
      <div class="card-body">
        @if (!Model.ActionLog.Any()) { <div class="tbl-empty">No history yet.</div> }
        <div class="timeline">
          @foreach (var log in Model.ActionLog)
          {
            <div class="tl-item">
              <div class="tl-icon @TlCls(log.Action)">@TlIco(log.Action)</div>
              <div class="tl-content">
                <div class="tl-actor">@log.ActorName</div>
                <div class="tl-meta">
                  @TlLbl(log.Action)
                  @if (log.IsWhatsApp)
                  {
                    <span title="Action received via WhatsApp" style="display:inline-flex;align-items:center;gap:3px;color:#25D366;font-weight:600">
                      <svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:#25D366" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.84-2-.94-.26-.1-.45-.14-.64.15-.19.28-.73.94-.9 1.13-.16.19-.33.21-.61.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.73-1.63-2.02-.17-.29-.02-.44.13-.59.13-.13.29-.33.44-.5.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.08-.15-.64-1.55-.88-2.12-.23-.55-.47-.48-.64-.49h-.55c-.19 0-.5.07-.76.36s-1 .98-1 2.38 1.02 2.76 1.17 2.95c.14.19 2.01 3.08 4.88 4.32.68.29 1.21.47 1.63.6.68.22 1.31.19 1.8.12.55-.08 1.7-.69 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.34zM12 2a10 10 0 00-8.6 15.06L2 22l5.05-1.32A10 10 0 1012 2z"/></svg>
                      via WhatsApp
                    </span>
                  }
                  @if (log.StepLevel.HasValue) { <span> · Step @log.StepLevel</span> }
                  · @log.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") IST
                </div>
                @if (!string.IsNullOrEmpty(log.Comment))
                { <div class="tl-comment">@log.Comment</div> }
                @if (log.Attachments.Any())
                {
                  <div style="margin-top:6px">
                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--txt3);margin-bottom:5px">Attachments</div>
                    @foreach (var att in log.Attachments)
                    {
                      <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px">
                        <svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:var(--in);fill:none;flex-shrink:0" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
                        <span style="font-size:12px;color:var(--txt1)">@att.FileName</span>
                        @if (!readOnly)
                        {
                          @if (att.AttachmentType == "Requestor")
                          {
                            <a asp-action="Download" asp-route-id="@Model.RequestId" asp-route-docId="@att.Id" class="btn btn-sec btn-sm" style="padding:2px 8px;font-size:11px">Download</a>
                          }
                          else if (att.AttachmentType == "Reply")
                          {
                            <a href="@att.Url" target="_blank" rel="noopener" class="btn btn-sec btn-sm" style="padding:2px 8px;font-size:11px">View / Download</a>
                          }
                          else
                          {
                            <a asp-action="DownloadApproval" asp-route-id="@Model.RequestId" asp-route-attachmentId="@att.Id" class="btn btn-sec btn-sm" style="padding:2px 8px;font-size:11px">Download</a>
                          }
                        }
                      </div>
                    }
                  </div>
                }
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
}

@if (tab == "documents")
{
  <div style="max-width:640px;display:flex;flex-direction:column;gap:14px">
    @if (!readOnly && Model.Status == "Draft")
    {
      <div class="card">
        <div class="card-hdr">
          <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload Document
        </div>
        <div class="card-body">
          <form asp-action="Upload" asp-route-id="@Model.RequestId" asp-route-source="@src" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
              <div class="form-group" style="flex:1">
                <label class="lbl">File</label>
                <input type="file" name="file" class="inp" accept=".pdf,.docx,.xlsx,.csv,.png,.jpg,.jpeg"/>
              </div>
              <button type="submit" class="btn btn-pri">Upload</button>
            </div>
            <div class="hint">PDF, Word, Excel, CSV, PNG/JPG — max 20 MB</div>
          </form>
        </div>
      </div>
    }
    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13,2 13,9 20,9"/></svg>
        Requestor Attachments
        <span class="tab-cnt" style="margin-left:auto">@Model.Documents.Count</span>
      </div>
      <div>
        @if (!Model.Documents.Any()) { <div class="tbl-empty">No documents attached.</div> }
        @foreach (var doc in Model.Documents)
        {
          <div style="display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--bg)">
            <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:var(--in);fill:none;flex-shrink:0"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13,2 13,9 20,9"/></svg>
            <div style="flex:1;min-width:0">
              <div style="font-size:12px;font-weight:600">@doc.FileName</div>
              <div style="font-size:11px;color:var(--txt3)">@doc.FormattedSize · @doc.UploadedAt.ToString("dd MMM yyyy") · @doc.UploadedByName</div>
            </div>
            @if (!readOnly)
            {
              <div style="display:flex;gap:6px">
                <a asp-action="Download" asp-route-id="@Model.RequestId" asp-route-docId="@doc.DocumentId" class="btn btn-sec btn-sm">Download</a>
                @if (Model.Status == "Draft")
                {
                  <form asp-action="DeleteDoc" asp-route-id="@Model.RequestId" asp-route-docId="@doc.DocumentId" asp-route-source="@src" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ng btn-sm" onclick="return confirm('Remove document?')">Remove</button>
                  </form>
                }
              </div>
            }
          </div>
        }
      </div>
    </div>

    <div class="card">
      <div class="card-hdr">
        <svg viewBox="0 0 24 24"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13,2 13,9 20,9"/></svg>
        Approval Attachments
        <span class="tab-cnt" style="margin-left:auto">@Model.ApprovalAttachments.Count</span>
      </div>
      <div>
        @if (!Model.ApprovalAttachments.Any()) { <div class="tbl-empty">No approval attachments uploaded.</div> }
        @foreach (var att in Model.ApprovalAttachments)
        {
          <div style="display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--bg)">
            <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:var(--ok);fill:none;flex-shrink:0"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13,2 13,9 20,9"/></svg>
            <div style="flex:1;min-width:0">
              <div style="font-size:12px;font-weight:600">@att.FileName</div>
              <div style="font-size:11px;color:var(--txt3)">
                Level @att.StepLevel ·
                <span class="badge @(att.ActionType switch{"approved"=>"badge-green","rejected"=>"badge-red",_=>"badge-amber"})" style="font-size:10px;padding:1px 6px">
                  @(att.ActionType switch{"approved"=>"Approved","rejected"=>"Rejected","clarification"=>"Clarification",_=>att.ActionType})
                </span>
                @if (att.Url != null)
                {
                  <span title="Received via WhatsApp" style="color:#25D366;font-weight:600"> · via WhatsApp</span>
                }
                @if (att.FileSizeBytes > 0) { <text> · @att.FormattedSize</text> }
                · @att.UploadedAt.ToString("dd MMM yyyy") · @att.UploadedByName
              </div>
            </div>
            @if (!readOnly)
            {
              @if (att.Url != null)
              {
                <a href="@att.Url" target="_blank" rel="noopener" class="btn btn-sec btn-sm">View / Download</a>
              }
              else
              {
                <a asp-action="DownloadApproval" asp-route-id="@Model.RequestId" asp-route-attachmentId="@att.AttachmentId" class="btn btn-sec btn-sm">Download</a>
              }
            }
          </div>
        }
      </div>
    </div>
  </div>
}

@if (ViewBag.ClarificationMode == true)
{
  @* Opened via the grid's Clarification action (?mode=clarification) — bring the
     Submit Clarification panel into view. *@
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('clarificationPanel');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
}

@* ── Revoke Request Modal ── *@
<div id="revokeModal" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center">
  <div onclick="closeRevokeModal()" style="position:absolute;inset:0;background:rgba(0,0,0,.45)"></div>
  <div style="position:relative;background:var(--card);border:1px solid var(--bdr);border-radius:var(--rl);box-shadow:0 8px 32px rgba(0,0,0,.18);width:100%;max-width:460px;margin:16px;max-height:calc(100vh - 32px);overflow-y:auto;padding:0">
    <div style="padding:16px 20px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between">
      <span style="font-size:15px;font-weight:700">Revoke Request</span>
      <button onclick="closeRevokeModal()" type="button" style="background:none;border:none;cursor:pointer;color:var(--txt3);font-size:20px;line-height:1;padding:0 4px">&times;</button>
    </div>
    <form id="revokeForm" method="post" action="">
      @Html.AntiForgeryToken()
      <div style="padding:20px">
        <div style="font-size:13px;color:var(--txt2);margin-bottom:14px">Please provide the reason for revoking request <strong id="revokeReqNum" class="mono"></strong>.</div>
        <div id="revokeErr" style="display:none;background:var(--ng-bg);border:1px solid var(--ng-bdr);color:var(--ng);border-radius:var(--r);padding:10px 14px;margin-bottom:14px;font-size:13px"></div>
        <div style="margin-bottom:6px">
          <label class="lbl" style="display:block;margin-bottom:4px">Revoke Remark <span style="color:var(--ng)">*</span></label>
          <textarea id="revokeRemark" name="revokeRemark" class="inp" rows="3" maxlength="500"
            placeholder="Reason for revoking this request…"
            style="width:100%;resize:none;overflow:hidden;min-height:70px;max-height:250px"></textarea>
          <div style="text-align:right;font-size:11px;color:var(--txt3);margin-top:4px"><span id="revokeRemarkCount">0</span> / 500</div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
          <button type="button" onclick="closeRevokeModal()" class="btn btn-sec btn-sm">Cancel</button>
          <button type="submit" onclick="return submitRevoke()" class="btn btn-ng btn-sm">Submit</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  function revokeAutoGrow(ta) {
    if (!ta) return;
    ta.style.height = 'auto';
    if (ta.scrollHeight > 250) { ta.style.height = '250px'; ta.style.overflowY = 'auto'; }
    else { ta.style.height = ta.scrollHeight + 'px'; ta.style.overflowY = 'hidden'; }
  }
  // Carries the mobile marker onto the Revoke post so it returns to the mobile pending list
  // (empty string on desktop — the URL is then exactly what it was before).
  var revokeSrc = '@(src == "mobile" ? "?source=mobile" : "")';
  function openRevokeModal(id, num) {
    var f = document.getElementById('revokeForm');
    f.action = '/Requests/Revoke/' + id + revokeSrc;
    document.getElementById('revokeReqNum').textContent = num;
    var ta = document.getElementById('revokeRemark');
    ta.value = '';
    document.getElementById('revokeRemarkCount').textContent = '0';
    document.getElementById('revokeErr').style.display = 'none';
    revokeAutoGrow(ta);
    document.getElementById('revokeModal').style.display = 'flex';
    ta.focus();
  }
  function closeRevokeModal() { document.getElementById('revokeModal').style.display = 'none'; }
  function submitRevoke() {
    var ta  = document.getElementById('revokeRemark');
    var err = document.getElementById('revokeErr');
    if (!ta.value.trim()) { err.textContent = 'Revoke remark is required.'; err.style.display = 'block'; ta.focus(); return false; }
    if (ta.value.length > 500) { err.textContent = 'Revoke remark cannot exceed 500 characters.'; err.style.display = 'block'; ta.focus(); return false; }
    return true;
  }
  (function () {
    var ta = document.getElementById('revokeRemark');
    var counter = document.getElementById('revokeRemarkCount');
    if (ta) ta.addEventListener('input', function () {
      if (counter) counter.textContent = ta.value.length;
      revokeAutoGrow(ta);
    });
  })();
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeRevokeModal(); });
</script>
