@model RequestListVM
@{
    ViewData["Title"] = "Requests";
    ViewData["NavPage"] = "requests";
    string Sc(string s) => s switch {"Approved"=>"badge-green","Rejected"=>"badge-red","Pending Approval"=>"badge-blue","Partial Approved"=>"badge-sky","Clarification Needed"=>"badge-amber","Draft"=>"badge-gray","Deleted"=>"badge-dark",_=>"badge-gray"};
    string Pc(string p) => p switch {"Critical"=>"badge-red","High"=>"badge-amber","Medium"=>"badge-blue",_=>"badge-gray"};
}

<div class="pg-hdr">
  <div><div class="pg-title">Approval Requests</div><div class="pg-sub">@Model.TotalCount records · Page @Model.PageNumber of @Model.TotalPages</div></div>
  <div class="pg-actions">
    @* Excel Download Button *@
    <a href="/Requests/ExportExcel?SearchTerm=@Model.SearchTerm&FilterStatus=@Model.FilterStatus&FilterTypeId=@Model.FilterTypeId&FilterPriority=@Model.FilterPriority&FilterDeptId=@Model.FilterDeptId&FilterLocationId=@Model.FilterLocationId"
       class="btn btn-sec btn-sm" title="Download Excel"
       style="display:inline-flex;align-items:center;gap:6px">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9,14 12,17 15,14"/>
      </svg>
      Export Excel
    </a>
    <a asp-action="Create" class="btn btn-acc">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Request
    </a>
  </div>
</div>

<form method="get" asp-action="Index">
  <div class="filter-bar">
    <div class="f-group" style="flex:1;min-width:180px">
      <label class="f-lbl">Search</label>
      <div class="f-srch-w">
        <svg class="f-srch-ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="f-ctrl f-srch" placeholder="Title, requestor, ID…"/>
      </div>
    </div>
    <div class="f-group">
      <label class="f-lbl">Status</label>
      <select name="FilterStatus" class="f-ctrl">
        <option value="">All</option>
        @foreach (var s in new[]{"Draft","Pending Approval","Partial Approved","Approved","Rejected","Clarification Needed","Deleted"})
        { <option value="@s" selected="@(Model.FilterStatus==s)">@s</option> }
      </select>
    </div>
    <div class="f-group">
      <label class="f-lbl">Type</label>
      <select name="FilterTypeId" class="f-ctrl">
        <option value="">All</option>
        @foreach (var t in Model.RequestTypes)
        { <option value="@t.RequestTypeId" >@t.TypeName</option> 
       @*  <option value="@t.RequestTypeId" @(Model.FilterTypeId==t.RequestTypeId?"selected":"")>@t.TypeName</option> *@
        }
      </select>
    </div>
    <div class="f-group">
      <label class="f-lbl">Priority</label>
      <select name="FilterPriority" class="f-ctrl">
        <option value="">All</option>
        @foreach (var p in new[]{"Low","Medium","High","Critical"})
        { <option value="@p">@p</option> 
       @*  <option value="@p" @(Model.FilterPriority==p?"selected":"")>@p</option> *@
        }
      </select>
    </div>
    <div class="f-group">
      <label class="f-lbl">Department</label>
      <select name="FilterDeptId" class="f-ctrl">
        <option value="">All</option>
        @foreach (var d in Model.Departments)
        { <option value="@d.DepartmentId" >@d.DeptName</option>
       @*  <option value="@d.DepartmentId" @(Model.FilterDeptId==d.DepartmentId?"selected":"")>@d.DeptName</option> *@
        }
      </select>
    </div>
    <div class="f-group">
      <label class="f-lbl">Location</label>
      <select name="FilterLocationId" class="f-ctrl">
        <option value="">All</option>
        @foreach (var l in Model.Locations)
        { <option value="@l.LocationId">@l.LocationName</option>
            @* <option value="@l.LocationId" @(Model.FilterLocationId==l.LocationId?"selected":"")>@l.LocationName</option> *@ }
      </select>
    </div>
    <div style="display:flex;gap:6px;align-items:flex-end">
      <button type="submit" class="btn btn-pri btn-sm">Filter</button>
      <a asp-action="Index" class="btn btn-sec btn-sm">Clear</a>
    </div>
  </div>
</form>

<div class="card">
  <div class="tbl-wrap">
    <table class="tbl">
      <thead>
        <tr>
          <th>Request #</th><th>Title</th><th>Requestor</th><th>Type</th>
          <th>Priority</th><th>Amount</th><th>Status</th><th>Created</th>
          <th class="r">Actions</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Items.Any())
        {
          <tr><td colspan="9" class="tbl-empty">
            <div style="margin-bottom:8px">📋</div>
            No requests found.
            <a asp-action="Create" style="margin-left:6px">Create the first one →</a>
          </td></tr>
        }
        @foreach (var r in Model.Items)
        {
          <tr>
            <td><span class="mono" style="background:var(--bg);padding:2px 6px;border-radius:4px">@r.RequestNumber</span></td>
            <td style="max-width:200px">
              <div style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Title</div>
              <div style="font-size:11px;color:var(--txt3)">@r.DeptName · @r.LocationName</div>
            </td>
            <td style="font-size:13px">@r.RequestorName</td>
            <td style="font-size:12px">@r.RequestTypeName</td>
            <td><span class="badge @Pc(r.Priority)">@r.Priority</span></td>
            <td style="font-weight:600">@(r.Amount.HasValue ? "₹"+r.Amount.Value.ToString("N0") : "—")</td>
            <td><span class="badge @Sc(r.Status)">@r.Status</span></td>
            <td style="font-size:11px;color:var(--txt3);white-space:nowrap">@r.CreatedAt.ToString("dd MMM yyyy")</td>
            <td class="r">
              <div style="display:inline-flex;gap:4px;align-items:center">
                <a asp-action="Detail" asp-route-id="@r.RequestId"
                   class="btn btn-sec btn-sm" title="View"
                   style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
                @* Print Button *@
                <a href="/Requests/Print/@r.RequestId" target="_blank"
                   class="btn btn-sec btn-sm" title="Print"
                   style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6,9 6,2 18,2 18,9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                </a>
                @if (r.Status == "Draft" || r.Status == "Clarification Needed")
                {
                  <a asp-action="Edit" asp-route-id="@r.RequestId"
                     class="btn btn-sec btn-sm" title="Edit"
                     style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                }
                @if (ViewBag.CanDelete == true)
                {
                  @if (r.Status == "Pending Approval")
                  {
                    <form asp-action="Delete" asp-route-id="@r.RequestId" method="post" style="display:inline">
                      @Html.AntiForgeryToken()
                      <button type="submit" title="Delete"
                        style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid var(--danger,#ef4444);background:transparent;border-radius:6px;cursor:pointer;color:var(--danger,#ef4444)"
                        onclick="return confirm('Delete request @r.RequestNumber? This cannot be undone.')">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                      </button>
                    </form>
                  }
                  else
                  {
                    <button type="button" title="Delete" onclick="alert('Only requests with Pending Approval status can be deleted.')"
                      style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid var(--danger,#ef4444);background:transparent;border-radius:6px;cursor:pointer;color:var(--danger,#ef4444)">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  }
                }
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if (Model.TotalPages > 1)
  {
    <div class="card-footer">
      <span>Showing @((Model.PageNumber-1)*Model.PageSize+1)–@(Math.Min(Model.PageNumber*Model.PageSize,Model.TotalCount)) of @Model.TotalCount</span>
      <div class="pager">
        @if (Model.PageNumber > 1)
        { <a class="pb" asp-action="Index" asp-route-page="@(Model.PageNumber-1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-FilterStatus="@Model.FilterStatus">‹</a> }
        @for (int p = Math.Max(1,Model.PageNumber-2); p <= Math.Min(Model.TotalPages,Model.PageNumber+2); p++)
        { <a class="pb @(p==Model.PageNumber?"active":"")" asp-action="Index" asp-route-page="@p" asp-route-SearchTerm="@Model.SearchTerm" asp-route-FilterStatus="@Model.FilterStatus">@p</a> }
        @if (Model.PageNumber < Model.TotalPages)
        { <a class="pb" asp-action="Index" asp-route-page="@(Model.PageNumber+1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-FilterStatus="@Model.FilterStatus">›</a> }
      </div>
    </div>
  }
</div>
