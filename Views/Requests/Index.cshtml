@model RequestListVM
@{
    ViewData["Title"] = "Requests";
    ViewData["NavPage"] = "requests";
    string Sc(string s) => s switch {"Approved"=>"badge-green","Rejected"=>"badge-red","Pending Approval"=>"badge-blue","Open"=>"badge-blue","Partial Approved"=>"badge-sky","Clarification Needed"=>"badge-amber","Draft"=>"badge-gray","Deleted"=>"badge-dark","Revoked"=>"badge-gray",_=>"badge-gray"};
    string Pc(string p) => p switch {"Critical"=>"badge-red","High"=>"badge-amber","Medium"=>"badge-blue",_=>"badge-gray"};
    string Ds(string s) => s == "Open" ? "Pending Approval" : s;
    // Approval Requests mode: the page was opened from the dashboard "My Approvals" KPI
    // cards. Filtering runs against the approver's assigned set and the Status filter uses
    // friendly tokens (?status=) rather than raw request statuses.
    bool isApprovals = ViewBag.IsMyApprovals == true;
    // Territory mode: opened from the dashboard "My Territory" KPI cards. The grid is
    // scoped server-side to the user's department/location; the Status filter uses the
    // normal raw-status dropdown (same as the default Index), just posted to the Territory
    // action so the scope is preserved across filtering/paging.
    bool isTerritory = ViewBag.IsTerritory == true;
    string approvalStatus = ViewBag.ApprovalStatus as string ?? "";
    string listAction = isApprovals ? "Approval" : isTerritory ? "Territory" : "Index";

    // ── Dashboard context ─────────────────────────────────────
    // Every dashboard KPI card links here with ?dtab=<dashboard tab>. The token is echoed on
    // the filter form, the Clear link and every pager link, so it survives filtering/paging,
    // and it drives the "← Back" button, which returns to that exact dashboard tab. Absent
    // (the page reached from the nav menu) nothing is rendered and the page is unchanged.
    var dtabRaw = Context.Request.Query["dtab"].ToString();
    string? dashTab = new[]{ "requests", "approvals", "territory", "admin" }.Contains(dtabRaw) ? dtabRaw : null;
    // This grid's own URL — handed to the Detail page as ?ret= so its Back button returns
    // here with the KPI filter, search term and page number intact.
    var retUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    // Which grid the Export button must export (matches listAction).
    string exportMode = isApprovals ? "approvals" : isTerritory ? "territory" : "";
    // "true" only on the My Requests list, so the scope rides along on Clear and the pager.
    string? mineToken = Model.FilterMine ? "true" : null;
}

<div class="pg-hdr">
  <div><div class="pg-title">Approval Requests</div><div class="pg-sub">@Model.TotalCount records · Page @Model.PageNumber of @Model.TotalPages</div></div>
  <div class="pg-actions">
    @* Back to the dashboard tab this list was opened from (dashboard KPI click-through only) *@
    @if (dashTab != null)
    {
      @* Literal URL — dashTab is whitelisted to one of four fixed tokens above, and this
         leaves no doubt that ?tab= reaches the Dashboard, which resolves it server-side. *@
      <a href="~/Dashboard?tab=@dashTab" class="btn btn-sec btn-sm">← Back</a>
    }
    @* Excel Download Button - opens date range modal *@
    <button type="button" onclick="openExportModal()" class="btn btn-sec btn-sm" title="Export to CSV"
       style="display:inline-flex;align-items:center;gap:6px">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9,14 12,17 15,14"/>
      </svg>
      Export Excel
    </button>
    <a asp-action="Create" class="btn btn-acc">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Request
    </a>
  </div>
</div>

<form method="get" asp-action="@listAction">
  @* Keeps the dashboard context (and the Back button) alive across Filter submits *@
  @if (dashTab != null) { <input type="hidden" name="dtab" value="@dashTab" /> }
  @* "My Requests" scope — without this a Filter submit would widen an Admin's grid to all requests *@
  @if (Model.FilterMine) { <input type="hidden" name="FilterMine" value="true" /> }
  <div class="filter-bar" style="gap:8px">
    <div class="f-group" style="flex:1 1 160px;min-width:0">
      <label class="f-lbl">Search</label>
      <div class="f-srch-w">
        <svg class="f-srch-ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="f-ctrl f-srch" style="min-width:0;width:100%" placeholder="Title, requestor, ID…"/>
      </div>
    </div>
    <div class="f-group" style="flex:1 1 130px;min-width:0">
      <label class="f-lbl">Status</label>
      @if (isApprovals)
      {
        @* Friendly approval tokens → /Requests/Approval?status=… (auto-selected from the KPI card that was clicked) *@
        <select name="status" class="f-ctrl" style="width:100%">
          <option value="">All</option>
          @foreach (var opt in new[]{ ApprovalStatusFilter.Pending, ApprovalStatusFilter.Approved, ApprovalStatusFilter.Rejected, ApprovalStatusFilter.Clarification })
          { <option value="@opt" selected="@(string.Equals(approvalStatus, opt, StringComparison.OrdinalIgnoreCase))">@opt</option> }
        </select>
      }
      else
      {
        <select name="FilterStatus" class="f-ctrl" style="width:100%">
          <option value="">All</option>
          @foreach (var s in new[]{"Draft","Pending Approval","Partial Approved","Approved","Rejected","Clarification Needed","Revoked","Deleted"})
          { <option value="@s" selected="@(Model.FilterStatus==s)">@s</option> }
        </select>
      }
    </div>
    <div class="f-group" style="flex:1 1 100px;min-width:0">
      <label class="f-lbl">Type</label>
      <select name="FilterTypeId" class="f-ctrl" style="width:100%">
        <option value="">All</option>
        @foreach (var t in Model.RequestTypes)
        { <option value="@t.RequestTypeId" selected="@(Model.FilterTypeId==t.RequestTypeId)">@t.TypeName</option> }
      </select>
    </div>
    <div class="f-group" style="flex:1 1 90px;min-width:0">
      <label class="f-lbl">Priority</label>
      <select name="FilterPriority" class="f-ctrl" style="width:100%">
        <option value="">All</option>
        @foreach (var p in new[]{"Low","Medium","High","Critical"})
        { <option value="@p" selected="@(Model.FilterPriority==p)">@p</option> }
      </select>
    </div>
    <div class="f-group" style="flex:1 1 110px;min-width:0">
      <label class="f-lbl">Department</label>
      <select name="FilterDeptId" class="f-ctrl" style="width:100%">
        <option value="">All</option>
        @foreach (var d in Model.Departments)
        { <option value="@d.DepartmentId" selected="@(Model.FilterDeptId==d.DepartmentId)">@d.DeptName</option> }
      </select>
    </div>
    <div class="f-group" style="flex:1 1 100px;min-width:0">
      <label class="f-lbl">Location</label>
      <select name="FilterLocationId" class="f-ctrl" style="width:100%">
        <option value="">All</option>
        @foreach (var l in Model.Locations)
        { <option value="@l.LocationId" selected="@(Model.FilterLocationId==l.LocationId)">@l.LocationName</option> }
      </select>
    </div>
    <div class="f-group" style="flex:0 0 130px">
      <label class="f-lbl">From Date</label>
      <input type="date" name="FilterDateFrom" id="filterDateFrom" value="@Model.FilterDateFrom" class="f-ctrl" style="width:130px" />
    </div>
    <div class="f-group" style="flex:0 0 130px">
      <label class="f-lbl">To Date</label>
      <input type="date" name="FilterDateTo" id="filterDateTo" value="@Model.FilterDateTo" class="f-ctrl" style="width:130px" />
    </div>
    <div class="f-group" style="flex:0 0 auto">
      <div id="dateRangeError" style="display:none;color:var(--ng,#ef4444);font-size:11px;white-space:nowrap;margin-bottom:4px">From Date cannot be greater than To Date.</div>
      <div style="display:flex;gap:6px">
        <button type="submit" class="btn btn-pri btn-sm" onclick="return validateDateRange()">Filter</button>
        <a asp-action="@listAction" asp-route-dtab="@dashTab" asp-route-FilterMine="@mineToken" class="btn btn-sec btn-sm">Clear</a>
      </div>
    </div>
  </div>
</form>

<div class="card">
  <div class="tbl-wrap">
    <table class="tbl">
      <thead>
        <tr>
          <th>Request #</th><th>Title</th><th>Requestor</th><th>Type</th>
          <th>Priority</th><th>Amount</th><th>Status</th><th>Created</th>
          <th class="r">Actions</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Items.Any())
        {
          <tr><td colspan="9" class="tbl-empty">
            <div style="margin-bottom:8px">📋</div>
            No requests found.
            <a asp-action="Create" style="margin-left:6px">Create the first one →</a>
          </td></tr>
        }
        @foreach (var r in Model.Items)
        {
          <tr>
            <td><span class="mono" style="background:var(--bg);padding:2px 6px;border-radius:4px">@r.DisplayRequestNumber</span></td>
            <td style="max-width:200px">
              <div style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Title</div>
              <div style="font-size:11px;color:var(--txt3)">@r.DeptName · @r.LocationName</div>
            </td>
            <td style="font-size:13px">@r.RequestorName</td>
            <td style="font-size:12px">@r.RequestTypeName</td>
            <td><span class="badge @Pc(r.Priority)">@r.Priority</span></td>
            <td style="font-weight:600">@(r.Amount.HasValue ? "₹"+r.Amount.Value.ToString("N0") : "—")</td>
            <td><span class="badge @Sc(r.Status)">@Ds(r.Status)</span></td>
            <td style="font-size:11px;color:var(--txt3);white-space:nowrap">@r.CreatedAt.ToString("dd MMM yyyy")</td>
            <td class="r">
              <div style="display:inline-flex;gap:4px;align-items:center">
                @* Requester on a Clarification Needed request: replace View with a
                   dedicated Clarification action (server-side check on status + owner). *@
                @if (r.Status == "Clarification Needed" && r.IsRequester)
                {
                  <a asp-action="Detail" asp-route-id="@r.RequestId" asp-route-mode="clarification" asp-route-ret="@retUrl"
                     class="btn btn-sm" title="Respond to Clarification"
                     style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid #d97706;background:#d97706;color:#fff;border-radius:6px">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                  </a>
                  <a href="/Requests/Print/@r.RequestId" target="_blank"
                     class="btn btn-sec btn-sm" title="Print"
                     style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6,9 6,2 18,2 18,9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                  </a>
                  @if (r.CanRevoke)
                  {
                    <button type="button" title="Revoke Request" onclick="openRevokeModal(@r.RequestId, '@r.DisplayRequestNumber')"
                      style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid var(--txt3,#6b7280);background:transparent;border-radius:6px;cursor:pointer;color:var(--txt2,#6b7280)">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                    </button>
                  }
                }
                else
                {
                <a asp-action="Detail" asp-route-id="@r.RequestId" asp-route-ret="@retUrl"
                   class="btn btn-sec btn-sm" title="View"
                   style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
                @* Print Button *@
                <a href="/Requests/Print/@r.RequestId" target="_blank"
                   class="btn btn-sec btn-sm" title="Print"
                   style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6,9 6,2 18,2 18,9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                </a>
                @if (r.CanRevoke)
                {
                  <button type="button" title="Revoke Request" onclick="openRevokeModal(@r.RequestId, '@r.DisplayRequestNumber')"
                    style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid var(--txt3,#6b7280);background:transparent;border-radius:6px;cursor:pointer;color:var(--txt2,#6b7280)">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                  </button>
                }
                @* In territory mode the grid also lists co-workers' requests; Edit is owner-
                   only (UpdateAsync re-checks), so only offer it on the viewer's own rows. *@
                @if (r.Status == "Draft" && (!isTerritory || r.IsRequester))
                {
                  <a asp-action="Edit" asp-route-id="@r.RequestId"
                     class="btn btn-sec btn-sm" title="Edit"
                     style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                }
                @* Delete is owner-only for non-admins (DeleteAsync re-checks). In territory
                   mode, don't offer it on co-workers' rows the viewer can't delete. *@
                @if (ViewBag.CanDelete == true && (!isTerritory || r.IsRequester))
                {
                  @if (r.Status == "Pending Approval" || r.Status == "Open")
                  {
                    <form asp-action="Delete" asp-route-id="@r.RequestId" method="post" style="display:inline">
                      @Html.AntiForgeryToken()
                      <button type="submit" title="Delete"
                        style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid var(--danger,#ef4444);background:transparent;border-radius:6px;cursor:pointer;color:var(--danger,#ef4444)"
                        onclick="return confirm('Delete request @r.DisplayRequestNumber? This cannot be undone.')">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                      </button>
                    </form>
                  }
                  else
                  {
                    <button type="button" title="Delete" onclick="alert('Only requests with Pending Approval status can be deleted.')"
                      style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid var(--danger,#ef4444);background:transparent;border-radius:6px;cursor:pointer;color:var(--danger,#ef4444)">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  }
                }
                }
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if (Model.TotalPages > 1)
  {
    <div class="card-footer">
      <span>Showing @((Model.PageNumber-1)*Model.PageSize+1)–@(Math.Min(Model.PageNumber*Model.PageSize,Model.TotalCount)) of @Model.TotalCount</span>
      <div class="pager">
        @{
          // In approval mode the status filter travels as the friendly `status` token;
          // otherwise as the raw FilterStatus. Passing null omits the unused one.
          string? pgStatusToken = isApprovals ? approvalStatus : null;
          string? pgFilterStatus = isApprovals ? null : Model.FilterStatus;
        }
        @if (Model.PageNumber > 1)
        { <a class="pb" asp-action="@listAction" asp-route-page="@(Model.PageNumber-1)" asp-route-dtab="@dashTab" asp-route-FilterMine="@mineToken" asp-route-status="@pgStatusToken" asp-route-SearchTerm="@Model.SearchTerm" asp-route-FilterStatus="@pgFilterStatus" asp-route-FilterTypeId="@Model.FilterTypeId" asp-route-FilterPriority="@Model.FilterPriority" asp-route-FilterDeptId="@Model.FilterDeptId" asp-route-FilterLocationId="@Model.FilterLocationId" asp-route-FilterDateFrom="@Model.FilterDateFrom" asp-route-FilterDateTo="@Model.FilterDateTo">‹</a> }
        @for (int p = Math.Max(1,Model.PageNumber-2); p <= Math.Min(Model.TotalPages,Model.PageNumber+2); p++)
        { <a class="pb @(p==Model.PageNumber?"active":"")" asp-action="@listAction" asp-route-page="@p" asp-route-dtab="@dashTab" asp-route-FilterMine="@mineToken" asp-route-status="@pgStatusToken" asp-route-SearchTerm="@Model.SearchTerm" asp-route-FilterStatus="@pgFilterStatus" asp-route-FilterTypeId="@Model.FilterTypeId" asp-route-FilterPriority="@Model.FilterPriority" asp-route-FilterDeptId="@Model.FilterDeptId" asp-route-FilterLocationId="@Model.FilterLocationId" asp-route-FilterDateFrom="@Model.FilterDateFrom" asp-route-FilterDateTo="@Model.FilterDateTo">@p</a> }
        @if (Model.PageNumber < Model.TotalPages)
        { <a class="pb" asp-action="@listAction" asp-route-page="@(Model.PageNumber+1)" asp-route-dtab="@dashTab" asp-route-FilterMine="@mineToken" asp-route-status="@pgStatusToken" asp-route-SearchTerm="@Model.SearchTerm" asp-route-FilterStatus="@pgFilterStatus" asp-route-FilterTypeId="@Model.FilterTypeId" asp-route-FilterPriority="@Model.FilterPriority" asp-route-FilterDeptId="@Model.FilterDeptId" asp-route-FilterLocationId="@Model.FilterLocationId" asp-route-FilterDateFrom="@Model.FilterDateFrom" asp-route-FilterDateTo="@Model.FilterDateTo">›</a> }
      </div>
    </div>
  }
</div>

@* ── Export Date Range Modal ── *@
<div id="exportModal" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center">
  <div onclick="closeExportModal()" style="position:absolute;inset:0;background:rgba(0,0,0,.45)"></div>
  <div style="position:relative;background:var(--card);border:1px solid var(--bdr);border-radius:var(--rl);box-shadow:0 8px 32px rgba(0,0,0,.18);width:100%;max-width:420px;margin:16px;max-height:calc(100vh - 32px);overflow-y:auto;padding:0">
    <div style="padding:16px 20px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between">
      <span style="font-size:15px;font-weight:700">Export Requests</span>
      <button onclick="closeExportModal()" type="button" style="background:none;border:none;cursor:pointer;color:var(--txt3);font-size:20px;line-height:1;padding:0 4px">&times;</button>
    </div>
    <div style="padding:20px">
      <div id="exportError" style="display:none;background:var(--ng-bg);border:1px solid var(--ng-bdr);color:var(--ng);border-radius:var(--r);padding:10px 14px;margin-bottom:16px;font-size:13px"></div>
      <div style="margin-bottom:14px">
        <label class="f-lbl" style="display:block;margin-bottom:4px">From Date <span style="color:var(--ng)">*</span></label>
        <input type="date" id="exportFromDate" class="f-ctrl inp" style="width:100%" />
        <div id="exportFromErr" style="display:none;color:var(--ng);font-size:12px;margin-top:4px">From Date is required.</div>
      </div>
      <div style="margin-bottom:20px">
        <label class="f-lbl" style="display:block;margin-bottom:4px">To Date <span style="color:var(--ng)">*</span></label>
        <input type="date" id="exportToDate" class="f-ctrl inp" style="width:100%" />
        <div id="exportToErr" style="display:none;color:var(--ng);font-size:12px;margin-top:4px">To Date is required.</div>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" onclick="closeExportModal()" class="btn btn-sec btn-sm">Cancel</button>
        <button type="button" onclick="submitExport()" id="exportBtn" class="btn btn-acc btn-sm"
          style="display:inline-flex;align-items:center;gap:6px">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9,14 12,17 15,14"/>
          </svg>
          Export
        </button>
      </div>
    </div>
  </div>
</div>

@* Hidden antiforgery token for AJAX export *@
<form id="exportAntiForgery" style="display:none">@Html.AntiForgeryToken()</form>

@* ── Revoke Request Modal (shared; target request set via openRevokeModal) ── *@
<div id="revokeModal" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center">
  <div onclick="closeRevokeModal()" style="position:absolute;inset:0;background:rgba(0,0,0,.45)"></div>
  <div style="position:relative;background:var(--card);border:1px solid var(--bdr);border-radius:var(--rl);box-shadow:0 8px 32px rgba(0,0,0,.18);width:100%;max-width:460px;margin:16px;max-height:calc(100vh - 32px);overflow-y:auto;padding:0">
    <div style="padding:16px 20px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between">
      <span style="font-size:15px;font-weight:700">Revoke Request</span>
      <button onclick="closeRevokeModal()" type="button" style="background:none;border:none;cursor:pointer;color:var(--txt3);font-size:20px;line-height:1;padding:0 4px">&times;</button>
    </div>
    <form id="revokeForm" method="post" action="">
      @Html.AntiForgeryToken()
      <div style="padding:20px">
        <div style="font-size:13px;color:var(--txt2);margin-bottom:14px">Please provide the reason for revoking request <strong id="revokeReqNum" class="mono"></strong>.</div>
        <div id="revokeErr" style="display:none;background:var(--ng-bg);border:1px solid var(--ng-bdr);color:var(--ng);border-radius:var(--r);padding:10px 14px;margin-bottom:14px;font-size:13px"></div>
        <div style="margin-bottom:6px">
          <label class="f-lbl" style="display:block;margin-bottom:4px">Revoke Remark <span style="color:var(--ng)">*</span></label>
          <textarea id="revokeRemark" name="revokeRemark" class="f-ctrl inp" rows="3" maxlength="500"
            placeholder="Reason for revoking this request…"
            style="width:100%;resize:none;overflow:hidden;min-height:70px;max-height:250px"></textarea>
          <div style="text-align:right;font-size:11px;color:var(--txt3);margin-top:4px"><span id="revokeRemarkCount">0</span> / 500</div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
          <button type="button" onclick="closeRevokeModal()" class="btn btn-sec btn-sm">Cancel</button>
          <button type="submit" onclick="return submitRevoke()" class="btn btn-ng btn-sm">Submit</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  function revokeAutoGrow(ta) {
    if (!ta) return;
    ta.style.height = 'auto';
    if (ta.scrollHeight > 250) { ta.style.height = '250px'; ta.style.overflowY = 'auto'; }
    else { ta.style.height = ta.scrollHeight + 'px'; ta.style.overflowY = 'hidden'; }
  }
  function openRevokeModal(id, num) {
    var f = document.getElementById('revokeForm');
    f.action = '/Requests/Revoke/' + id;
    document.getElementById('revokeReqNum').textContent = num;
    var ta = document.getElementById('revokeRemark');
    ta.value = '';
    document.getElementById('revokeRemarkCount').textContent = '0';
    document.getElementById('revokeErr').style.display = 'none';
    revokeAutoGrow(ta);
    document.getElementById('revokeModal').style.display = 'flex';
    ta.focus();
  }
  function closeRevokeModal() { document.getElementById('revokeModal').style.display = 'none'; }
  function submitRevoke() {
    var ta  = document.getElementById('revokeRemark');
    var err = document.getElementById('revokeErr');
    if (!ta.value.trim()) { err.textContent = 'Revoke remark is required.'; err.style.display = 'block'; ta.focus(); return false; }
    if (ta.value.length > 500) { err.textContent = 'Revoke remark cannot exceed 500 characters.'; err.style.display = 'block'; ta.focus(); return false; }
    return true;
  }
  (function () {
    var ta = document.getElementById('revokeRemark');
    var counter = document.getElementById('revokeRemarkCount');
    if (ta) ta.addEventListener('input', function () {
      if (counter) counter.textContent = ta.value.length;
      revokeAutoGrow(ta);
    });
  })();
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeRevokeModal(); });
</script>

<script>
  function openExportModal() {
    document.getElementById('exportModal').style.display = 'flex';
    document.getElementById('exportError').style.display = 'none';
    document.getElementById('exportFromErr').style.display = 'none';
    document.getElementById('exportToErr').style.display = 'none';
    var filterFrom = document.getElementById('filterDateFrom');
    var filterTo   = document.getElementById('filterDateTo');
    if (filterFrom && filterFrom.value) document.getElementById('exportFromDate').value = filterFrom.value;
    if (filterTo   && filterTo.value)   document.getElementById('exportToDate').value   = filterTo.value;
  }
  function closeExportModal() {
    document.getElementById('exportModal').style.display = 'none';
  }
  async function submitExport() {
    var fromDate = document.getElementById('exportFromDate').value;
    var toDate   = document.getElementById('exportToDate').value;
    var errEl    = document.getElementById('exportError');
    var fromErr  = document.getElementById('exportFromErr');
    var toErr    = document.getElementById('exportToErr');
    errEl.style.display = 'none';
    fromErr.style.display = 'none';
    toErr.style.display = 'none';

    var valid = true;
    if (!fromDate) { fromErr.style.display = 'block'; valid = false; }
    if (!toDate)   { toErr.style.display = 'block'; valid = false; }
    if (!valid) return;
    if (fromDate > toDate) {
      errEl.textContent = 'From Date cannot be greater than To Date.';
      errEl.style.display = 'block';
      return;
    }

    var btn = document.getElementById('exportBtn');
    btn.disabled = true;
    btn.textContent = 'Exporting…';

    var token = document.querySelector('#exportAntiForgery input[name="__RequestVerificationToken"]').value;
    // mode + status tell the server WHICH grid this is (Territory / My Approvals / My
    // Requests) so the export runs the same scoped query the page is showing.
    var params = new URLSearchParams({
      mode:             '@exportMode',
      status:           '@approvalStatus',
      FilterMine:       '@(Model.FilterMine ? "true" : "false")',
      FilterDateFrom:   fromDate,
      FilterDateTo:     toDate,
      SearchTerm:       '@Model.SearchTerm',
      FilterStatus:     '@Model.FilterStatus',
      FilterTypeId:     '@(Model.FilterTypeId?.ToString() ?? "")',
      FilterPriority:   '@Model.FilterPriority',
      FilterDeptId:     '@(Model.FilterDeptId?.ToString() ?? "")',
      FilterLocationId: '@(Model.FilterLocationId?.ToString() ?? "")',
      __RequestVerificationToken: token
    });

    try {
      var response = await fetch('/Requests/ExportExcel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
      });
      var contentType = response.headers.get('content-type') || '';
      if (contentType.includes('application/json')) {
        var data = await response.json();
        errEl.textContent = data.error || 'Export failed.';
        errEl.style.display = 'block';
      } else {
        var blob = await response.blob();
        var url  = window.URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href   = url;
        a.download = 'Requests_' + fromDate + '_to_' + toDate + '.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
        closeExportModal();
      }
    } catch (e) {
      errEl.textContent = 'An unexpected error occurred. Please try again.';
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9,14 12,17 15,14"/></svg> Export';
    }
  }
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeExportModal(); });

  function validateDateRange() {
    var from  = document.getElementById('filterDateFrom').value;
    var to    = document.getElementById('filterDateTo').value;
    var errEl = document.getElementById('dateRangeError');
    if (from && to && from > to) {
      errEl.style.display = 'block';
      return false;
    }
    errEl.style.display = 'none';
    return true;
  }
</script>
